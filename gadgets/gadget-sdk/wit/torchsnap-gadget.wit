///
/// Torchsnap Gadget Interface
///
/// Minimal initial definition covering lifecycle, catalog search,
/// query search, and execution. Expanded as real gadgets are converted.
package torchsnap:gadget@0.1.0;

/// ─── Host imports (provided by the host to gadgets) ─────
interface logging {
  enum log-level {
    trace,
    debug,
    info,
    warn,
    error,
  }

  /// Structured key-value metadata pair.
  type metadata-entry = tuple<string, string>;

  /// Log a message with optional structured metadata.
  /// The optional span associates this entry with an active span.
  log: func(level: log-level, message: string, metadata: list<metadata-entry>, span: option<u64>);

  /// Start a named timing span. Returns an opaque handle.
  /// Parent allows explicit nesting — pass the parent span's handle.
  /// Metadata attached at start is merged with end-metadata on completion.
  span-start: func(name: string, parent: option<u64>, metadata: list<metadata-entry>) -> u64;

  /// End a timing span. The host computes duration and emits a timing entry.
  /// End-metadata is merged with start-metadata (end wins on key collision).
  span-end: func(span-id: u64, metadata: list<metadata-entry>);
}

/// System clipboard write access.
///
/// WASM gadgets have no direct access to host APIs — they
/// can't reach `tauri_gadget_clipboard_manager` the way
/// native gadgets do. This interface exposes a single
/// write-text operation so gadgets can copy results to the
/// clipboard from inside `execute()`, `handle-message`, or
/// any other guest entry point.
///
/// Read access (paste, query) is intentionally NOT exposed.
/// Reading the clipboard from a sandboxed gadget would let
/// any gadget slurp arbitrary content the user has copied
/// from other applications, which is a privacy footgun.
/// Gadgets that need clipboard read should stay native or
/// wait for an explicit, audited extension of this
/// interface.
interface clipboard {
  /// Error type for clipboard operations.
  variant clipboard-error {
    /// The host clipboard backend reported a failure.
    backend-failure(string),
  }

  /// Write `text` to the system clipboard.
  write-text: func(text: string) -> result<_, clipboard-error>;
}

/// Per-gadget SQLite storage.
///
/// Each gadget gets an isolated database file at
/// `<app_data_dir>/gadget-home/<gadget-id>/sql/storage.sqlite3`. The host
/// creates the file and applies the migration files declared
/// in `manifest.toml`'s `[storage.sql]` table before the
/// guest's `enable()` runs. Gadgets obtain lightweight
/// connection handles via `connection()` and use them to
/// issue queries.
///
/// Gadgets are responsible for scoring, ordering, and
/// `IN (...)` expansion on their side — the WIT `sql-value`
/// variant intentionally omits the host's internal `List`
/// variant. Use `serde_json` (or any other serialization)
/// to marshal complex types in and out of `text` /
/// `blob` columns.
///
/// Bridge-level failures (missing migration file, malformed
/// SQL, filesystem permission) surface as an `enable()`
/// error on the host side — the guest never sees them.
/// Per-statement errors surface from `execute` / `query`.
interface sql-storage {
  /// A database value matching SQLite's five storage classes.
  /// Gadgets build query parameters and read result rows in
  /// terms of this variant.
  variant sql-value {
    null,
    integer(s64),
    real(f64),
    text(string),
    blob(list<u8>),
  }

  resource sql-handle {
    /// Execute a statement that modifies data (INSERT,
    /// UPDATE, DELETE). Returns the number of rows
    /// affected.
    execute: func(sql: string, params: list<sql-value>) -> result<u64, string>;
    /// Execute a SELECT and return all matching rows. Each
    /// row is a list of column values matching the SELECT's
    /// column order.
    query: func(sql: string, params: list<sql-value>) -> result<list<list<sql-value>>, string>;
  }

  /// Obtain a connection handle to the gadget's database.
  /// The host initializes the database (file creation,
  /// migrations) before the guest's `enable()` runs, so
  /// this always succeeds for gadgets that declare
  /// `[storage.sql]` in their manifest. The handle is
  /// released automatically via WIT resource drop semantics
  /// when the gadget lets it go out of scope.
  connection: func() -> sql-handle;
}

/// Gadget-scoped frecency tracking.
///
/// The host already records selections automatically before
/// dispatching `execute()` and applies frecency score bonuses
/// to every query gadget's results after `search()` returns
/// — neither path requires the gadget to do anything. This
/// interface exists for the narrower case of gadgets that
/// need to *read* frecency state to drive their own UI, e.g.
/// the emoji picker's empty-query browse mode, which surfaces
/// the user's most-used emoji when the query is just the
/// prefix character.
///
/// All calls are namespaced to the gadget's own ID — gadgets
/// cannot read other gadgets' frecency data, same guarantee
/// as the `settings` interface.
interface frecency {
  /// A single item with its computed frecency score. `score`
  /// is opaque — gadgets should treat it as a relative
  /// ordering key, not an absolute magnitude.
  record frecency-item {
    item-id: string,
    score: u32,
  }

  /// Whether frecency tracking is currently enabled. When
  /// false, `top-items` always returns empty and any
  /// frecency-driven UI should fall back to a static order.
  is-enabled: func() -> bool;

  /// Top-N items by frecency score, highest first. Items
  /// with zero score are omitted. Returns an empty list
  /// when frecency is disabled or no history exists.
  top-items: func(limit: u32) -> list<frecency-item>;
}

/// Read settings from this gadget's namespace.
///
/// Gadgets are confined to keys under `gadgets.<gadget-id>.`
/// — the host strips the prefix transparently. There is no
/// way to read other gadgets' settings or host-level keys.
///
/// Returned values are JSON-encoded strings (`true`, `42`,
/// `"hello"`, `{"a":1}`, …) so any TOML-compatible value
/// shape can cross the WIT boundary without inventing a
/// dedicated value variant. The gadget parses the JSON
/// into whatever shape it expects.
///
/// `none` means the key has never been set in the store,
/// neither by the manifest's `[settings]` defaults nor by a
/// runtime write. Gadgets typically fall back to a hard-coded
/// default in that case (the same default that lives in
/// `manifest.toml`).
interface settings {
  /// Returns the JSON-encoded value for `key`, or `none` if unset.
  /// `key` is relative to the gadget's namespace.
  get: func(key: string) -> option<string>;
}

/// Opens URLs and filesystem paths via the OS default handler chain
/// (browser, mail client, registered application, file manager).
///
/// WASM gadgets have no direct access to Tauri's opener APIs. This
/// interface exposes three operations:
///
/// - `open-url`     — open a URL with the registered scheme handler.
/// - `open-path`    — open a filesystem path with the registered
///                    application (Finder/Explorer/xdg-mime resolution).
/// - `reveal-path`  — reveal a filesystem path in the OS file manager.
///
/// Gadgets declare each capability under `[permissions.opener]` in
/// `manifest.toml`. The host enforces declarations at call time. Omitting
/// the section entirely (or declaring it with no granted capability)
/// means the gadget has no opener access (deny by default).
///
/// ```toml
/// [permissions.opener]
/// schemes      = ["https", "http"]   # for open-url
/// open-path    = true                # for open-path
/// reveal-path  = true                # for reveal-path
/// ```
///
/// The boolean gates intentionally do not constrain *which* paths the
/// gadget may target. A path-root allowlist would not narrow the
/// malicious-author threat (the malicious payload can ship inside the
/// gadget archive itself), and the legitimate use cases require broad
/// access. The trust signal is at the manifest-declaration level: a
/// gadget that can `open-path` is trusted to launch arbitrary registered
/// handlers; a gadget that cannot, cannot.
interface opener {
  /// Error variants shared by every `opener` operation. The shape
  /// mirrors `http-error` and `command-error`: one variant per
  /// semantic category, no catch-all.
  variant opener-error {
    /// The gadget's manifest does not grant the required capability:
    /// the URL's scheme is not in `[permissions.opener] schemes` for
    /// `open-url`, `open-path = false` for `open-path`, or
    /// `reveal-path = false` for `reveal-path`. The string describes
    /// the missing capability so gadget authors can fix their
    /// manifest.
    permission-denied(string),
    /// The URL passed to `open-url` failed to parse. Only emitted by
    /// `open-url`. The string is the offending URL.
    invalid-url(string),
    /// The host's opener / reveal backend reported a failure (no
    /// registered handler for the URL scheme or path type, file
    /// inaccessible, platform-specific failure mode). The string
    /// carries the backend's diagnostic message.
    backend-failure(string),
  }

  /// Open `url` in the OS default handler. Returns
  /// `permission-denied` if the scheme is not in the gadget's
  /// declared allowlist, `invalid-url` if `url` is not parseable,
  /// or `backend-failure` if the OS-level opener call fails.
  open-url: func(url: string) -> result<_, opener-error>;

  /// Open `path` with the OS-registered application for that path's
  /// type (LaunchServices on macOS, GIO on Linux, ShellExecute on
  /// Windows). Requires `open-path = true` in the gadget's
  /// `[permissions.opener]` block.
  open-path: func(path: string) -> result<_, opener-error>;

  /// Reveal `path` in the OS file manager (Show in Finder, Show in
  /// Files, Show in Explorer). Requires `reveal-path = true` in the
  /// gadget's `[permissions.opener]` block.
  reveal-path: func(path: string) -> result<_, opener-error>;
}

/// Minimal synchronous HTTP client for WASM gadgets.
///
/// WASM gadgets have no async runtime, so `fetch` is a blocking host call
/// executed on the host's thread pool. Gadgets declare allowed origins under
/// `[permissions.http]` in `manifest.toml`. The host enforces this at call
/// time. The special origin `"*"` opts the gadget into trust-all mode.
///
/// ```toml
/// [permissions.http]
/// origins = ["https://api.duckduckgo.com"]
///
/// # or trust-all:
/// origins = ["*"]
/// ```
interface http {
  /// HTTP method. The six common methods are named variants; `other(string)`
  /// covers non-standard methods (WebDAV, etc.) without exposing the common
  /// cases to typos.
  variant http-method {
    get,
    post,
    put,
    patch,
    delete,
    head,
    other(string),
  }

  /// A synchronous HTTP request issued by a WASM gadget through the host.
  ///
  /// `timeout-ms: none` delegates to the host default. `max-body-size: none`
  /// delegates to the host default (guards against unbounded downloads).
  /// `insecure-tls: true` disables TLS certificate verification for the
  /// request — required for talking to local daemons that ship a
  /// self-signed certificate (Docker over TLS, k3s, ...). The origin
  /// allowlist still gates which endpoint the gadget can reach.
  record http-request {
    url: string,
    method: http-method,
    headers: list<tuple<string, string>>,
    body: option<list<u8>>,
    timeout-ms: option<u32>,
    max-body-size: option<u64>,
    insecure-tls: bool,
  }

  /// The HTTP response returned to a WASM gadget. Status `100`–`599`
  /// is a successful round-trip — `4xx` and `5xx` are application-level
  /// outcomes, not errors. `http-error` covers only cases where no HTTP
  /// response was produced.
  record http-response {
    status: u16,
    headers: list<tuple<string, string>>,
    body: list<u8>,
  }

  /// Transport-level errors for `fetch`. Each variant covers a single
  /// category so gadgets can produce precise UX (e.g. distinguishing
  /// "daemon not running" from "auth failure" without string-matching).
  variant http-error {
    /// The request URL's origin is not in the gadget's declared
    /// allowlist. Message is the rejected origin.
    permission-denied(string),
    /// TCP / Unix-socket connect failed before any HTTP exchange —
    /// daemon not listening, port closed. Message is the underlying
    /// OS-level diagnostic.
    connection-refused(string),
    /// The request exceeded the configured or host-default timeout.
    timeout,
    /// DNS resolution failed for the request URL's host.
    dns-failed(string),
    /// TLS handshake / certificate validation failed. Set
    /// `insecure-tls: true` on the request to bypass certificate
    /// validation when talking to a self-signed local endpoint.
    tls-failed(string),
    /// The URL string did not parse, or the HTTP method string was
    /// rejected before the request was sent.
    invalid-url(string),
    /// A transport-level failure that doesn't fit the categories
    /// above. Message captures the underlying diagnostic.
    other(string),
  }

  /// Execute an HTTP request and return the full response. The call blocks
  /// until the response body is fully received or an error occurs.
  fetch: func(request: http-request) -> result<http-response, http-error>;
}

/// Read-only access to host filesystem paths declared in the gadget's
/// manifest.
///
/// Gadgets declare an exact-or-glob allowlist under
/// `[permissions.fs]` in `manifest.toml`. The host expands
/// `${home}` / `${xdg-config}` / `${xdg-data}` substitutions (same
/// vocabulary as `[[permissions.command]]` and `paths::resolve`),
/// canonicalizes the resulting patterns to resolve OS-level symlinks
/// (`/var → /private/var` on macOS, etc.), compiles them into a
/// `GlobSet`, and stores it on the per-gadget instance.
///
/// ```toml
/// [permissions.fs]
/// read = [
///     "${xdg-config}/myapp/config.toml",
///     "/var/lib/myapp/data/*.json",
/// ]
/// ```
///
/// Glob syntax: `*` matches a single path segment; `**` matches
/// across segments. `?`, character classes, and brace alternation
/// are intentionally not supported — a smaller surface area is
/// easier to audit, and exact paths cover the common case.
///
/// At call time the host:
/// 1. Rejects requested paths containing `..`, `.`, or `//` segments.
/// 2. Canonicalizes the path via `std::fs::canonicalize`, which
///    resolves symlinks all the way to the real target.
/// 3. Matches the canonicalized real path against the manifest's
///    canonicalized `GlobSet`. A match means "allowed"; anything
///    else is `permission-denied`.
///
/// The canonicalization step is what makes "follow symlinks" safe:
/// a symlink located inside an allowed pattern that points outside
/// the allow set is rejected because the resolved real path is no
/// longer covered.
///
/// Each call blocks the guest until the host returns. WASM guests
/// have no async runtime, and the host scheduler keeps other
/// gadgets responsive while one gadget waits on a read.
interface filesystem {
  /// Error variants for `read-file` and `file-metadata`. One variant
  /// per semantic category; no catch-all.
  variant fs-error {
    /// The request path validates and exists, but is not covered by
    /// the gadget's manifest allowlist. Message is the request path
    /// (post-canonicalization) for diagnostics.
    permission-denied(string),
    /// The request path was syntactically rejected before I/O —
    /// non-absolute, contained `..`/`.`/`//` segments, was empty,
    /// or contained a NUL byte. Message includes the offending
    /// path for diagnostics.
    invalid-path(string),
    /// The request path is well-formed but no such file exists.
    not-found,
    /// The host's filesystem layer reported an error while reading
    /// (permission failure on the underlying file, I/O error,
    /// canonicalization failure that wasn't `not-found`). Message
    /// captures the OS-level diagnostic.
    io(string),
  }

  /// Metadata about a file. `size` is the on-disk byte length;
  /// `modified-unix-ms` is the modification time as Unix epoch
  /// milliseconds; `is-symlink` reports whether the requested
  /// path is itself a symlink — observed *before* symlink
  /// resolution, so a gadget can tell when its allowlist let
  /// it through a symlink rather than a real file.
  record file-metadata {
    size: u64,
    modified-unix-ms: u64,
    is-symlink: bool,
  }

  /// Read the full contents of `path`. Resolves symlinks; the real
  /// target must also match the manifest allowlist. Gadgets that
  /// need a string interpret the returned bytes themselves
  /// (`String::from_utf8_lossy` etc.).
  read-file: func(path: string) -> result<list<u8>, fs-error>;

  /// Probe whether `path` is readable by this gadget. Returns
  /// `true` when the path exists and is covered by the manifest
  /// allowlist; `false` for *all* other reasons (path missing,
  /// path denied, syntactically invalid, I/O error). The conflated
  /// `false` is intentional — it lets a gadget walk a list of
  /// candidate paths and pick the first usable one without
  /// branching on error variants.
  file-exists: func(path: string) -> bool;

  /// Return metadata for `path`. Same allowlist gate as
  /// `read-file`.
  metadata: func(path: string) -> result<file-metadata, fs-error>;
}

/// Per-gadget asset access.
///
/// Every WASM gadget can read files from inside its own `.torchsnap`
/// archive (or development directory) via this interface. Gadgets do
/// NOT opt in — there is no `[permissions.assets]` section. The
/// guarantee is spatial: paths are validated by the same
/// `validate-gadget-path` guard that governs every other gadget-file
/// read on the host side, so the interface can only reach files
/// already inside the gadget root.
///
/// Bytes cross the WIT boundary in full on every `read` call — the
/// host holds no cached handle. Gadgets that need to retain an asset
/// should keep one copy in their own linear memory after reading.
///
/// Typical use: load a bundled JSON database at `enable()` time.
/// ```ignore
/// let bytes = assets::read("data/bangs.json")?;
/// ```
interface assets {
  /// Error variants for `read` and `exists`. The shape mirrors
  /// `http-error`: one variant per semantic category, no catch-all.
  variant assets-error {
    /// The path is outside the gadget root, or syntactically invalid
    /// (absolute, backslash-separated, contains `..` traversal, NUL
    /// byte, Windows drive letter, or empty). Message includes the
    /// offending path.
    invalid-path(string),
    /// The path validates but no such file exists inside the gadget.
    not-found,
    /// The host's filesystem (or archive) layer reported an error
    /// while reading. Permission problems, corrupt archives, etc.
    io-error(string),
  }

  /// Read a file inside the gadget. `path` is relative to the gadget
  /// root, same convention as `manifest.toml` path fields.
  read: func(path: string) -> result<list<u8>, assets-error>;

  /// Check whether a file exists inside the gadget without reading
  /// its bytes. Useful for optional assets (e.g. a bundled fallback
  /// that may or may not ship depending on the build).
  exists: func(path: string) -> result<bool, assets-error>;
}

/// Run a system process and capture its output.
///
/// Gadgets declare repeated `[[permissions.command]]` rules in
/// `manifest.toml`. Each rule names a `binary` plus per-position argv
/// constraints; a `command::run` call must match exactly one rule or
/// the host returns `permission-denied(string)`. The matcher is
/// pure and the manifest validator rejects any pair of rules whose
/// argv shapes could both accept the same call, so a permission
/// decision can never silently depend on rule ordering.
///
/// Constraints are defense-in-depth: they restrict the *shape* of
/// invocations, not the consequences of running a binary. A gadget
/// granted `git` will inherit whatever `git` reads from
/// `~/.gitconfig` and `/etc/gitconfig`. Argv constraints meaningfully
/// defend against unintentional misuse and against compositional
/// attacks where a gadget with `http::fetch` would otherwise pull
/// arbitrary paths from a remote response. They do not make a
/// determined malicious gadget author safe; that is a
/// distribution-time problem (see ADR 0036).
///
/// No shell. Argv goes directly to `Command::new(binary).args(args)`;
/// there is no shell tokenization step and no `/bin/sh -c` wrapping.
/// No streaming, no PTY, no persistent process handles. The host's
/// store lock means at most one `run` call is in flight per gadget
/// at a time.
///
/// ```toml
/// [[permissions.command]]
/// binary = "mdfind"
/// argv   = [
///   { kind = "literal", value = "kMDItemContentType == 'com.apple.application-bundle'" },
/// ]
///
/// [[permissions.command]]
/// binary = "git"
/// argv   = [
///   { kind = "literal", value = "log" },
///   { kind = "rest", constraint = { kind = "any-string" } },
/// ]
/// ```
interface command {
  /// Per-call options. All fields except `args` are optional; omitted
  /// fields fall back to the rule's `[[permissions.command]]` defaults
  /// or the host's hard ceilings.
  record command-options {
    /// Argument vector. Each element is matched per-position against
    /// the rule's argv constraints.
    args: list<string>,
    /// Working directory. When omitted, the host substitutes
    /// `<gadget-data>/exec-cwd/`, lazily created.
    cwd: option<string>,
    /// Additional environment variables. Layered on top of the host
    /// process env (with credential-leakage variables stripped).
    env: list<tuple<string, string>>,
    /// Bytes written to the child's stdin. Bounded by the host
    /// `max-stdin-bytes` ceiling and the per-rule `max-stdin-bytes`
    /// override if declared.
    stdin: option<list<u8>>,
    /// Wall-clock timeout in milliseconds. Bounded by the host
    /// default and the per-rule `timeout-ms-max` override if declared.
    timeout-ms: option<u32>,
    /// Maximum captured output bytes (sum of stdout and stderr).
    /// Bounded by the host default and per-rule `max-output-bytes`.
    max-output-bytes: option<u64>,
  }

  /// Result of a successful spawn.
  record command-result {
    /// Process exit code. `none` means the process was killed by a
    /// signal (`signal` carries the signal name).
    exit-code: option<s32>,
    /// Signal name (e.g. `"TERM"`) if the process was signaled.
    signal: option<string>,
    /// `true` if the host fired the timeout (always paired with a
    /// non-`none` `signal`).
    timed-out: bool,
    /// Captured stdout bytes (up to `max-output-bytes`).
    stdout: list<u8>,
    /// Captured stderr bytes (up to `max-output-bytes`).
    stderr: list<u8>,
  }

  /// Error variants for `run`.
  variant command-error {
    /// No `[[permissions.command]]` rule accepted this `(binary, argv)`.
    /// The string carries diagnostic context.
    permission-denied(string),
    /// `Command::new(...).spawn()` failed before the child was running
    /// — binary-not-found, permission-denied at the OS layer, etc.
    spawn-failed(string),
    /// The configured timeout fired and the child was killed.
    timeout,
    /// The configured output cap was reached. The child is killed; the
    /// captured `(stdout, stderr)` bytes up to the cap are returned for
    /// debugging.
    output-too-large(tuple<list<u8>, list<u8>>),
  }

  /// Spawn `binary` with `options.args`, wait for completion (or
  /// timeout), and return the captured result. See the interface-level
  /// docs for the trust model and the manifest declaration syntax.
  run: func(binary: string, options: command-options) -> result<command-result, command-error>;
}

/// Runtime OS and CPU architecture detection.
///
/// WASI does not expose either to guests. Gadgets making
/// platform-conditional decisions (different binaries on different
/// OSes, different default paths, OS-gated features) need this signal.
/// No permission is required: the values are informational and do not
/// widen the sandbox.
interface platform {
  variant os {
    macos,
    linux,
    windows,
    other(string),
  }

  variant arch {
    x86-64,
    aarch64,
    other(string),
  }

  /// The host's operating system.
  current-os: func() -> os;

  /// The host's CPU architecture.
  current-arch: func() -> arch;
}

/// Resolve manifest substitution variables at runtime.
///
/// Gadgets declare `${...}` substitution variables in
/// `[[permissions.command]]` `path-under` roots, `literal` values, and
/// per-rule `cwd`. The host resolves them at bridge construction time.
/// To construct argv strings that satisfy a `path-under` constraint
/// referencing host-resolved paths, the gadget needs the same resolved
/// values — that is what this interface provides.
///
/// Recognized variables match the manifest set:
/// `gadget-data`, `gadget-archive`, `home`, `xdg-config`, `xdg-data`.
///
/// No permission is required: the values are informational, and the
/// recognized list is closed (the host controls it).
///
/// ```ignore
/// let helper = paths::resolve("${gadget-archive}/bin/helper")?;
/// command::run(&helper, opts)?;
/// ```
interface path-resolver {
  variant resolve-error {
    /// A `${name}` token's `name` is not in the recognized list.
    /// The string is the offending name.
    unknown-variable(string),
    /// A `${` was not closed by `}` before the end of the template.
    /// The string is the partial token (everything after the `${`)
    /// for diagnostic display.
    unterminated(string),
  }

  /// Substitute every `${name}` token in `template` with the
  /// corresponding host-resolved path. Plain text passes through
  /// unchanged.
  resolve: func(template: string) -> result<string, resolve-error>;
}

/// ─── Guest exports (implemented by gadgets) ─────────────
interface lifecycle {
  /// Activate the gadget. Returning `err(string)` signals the
  /// host that initialization failed — the gadget will be
  /// disabled and no further calls dispatched to it. The
  /// error string is logged to the gadget's devtools stream.
  enable: func() -> result<_, string>;

  disable: func();

  /// Called by the host whenever a setting in this gadget's
  /// namespace changes. `key` is relative (matching the
  /// `settings::get` argument); `value` is the new
  /// JSON-encoded value, same encoding as `settings::get`.
  ///
  /// The host's existing CoalescingDispatcher (ADR 0026)
  /// runs *before* the change reaches the gadget, so rapid
  /// successive writes to the same key are deduplicated to
  /// the most recent value before this callback fires.
  on-setting-changed: func(key: string, value: string);
}

/// Shared types referenced by multiple imports/exports.
///
/// Pulled out into a dedicated interface so cross-direction
/// `use` declarations resolve to the same generated Rust type.
/// wasmtime bindgen treats types defined inside an *exported*
/// interface as guest-side; if a host *import* tries to `use`
/// them, the binding generator drags the whole interface in as
/// an import too. The fix is to define the shared variants in
/// a third interface that lives at package level and is `use`d
/// by both sides.
interface types {
  variant entry-icon {
    hero-icon(string),
    data-url(string),
    /// File asset reference. Pass a path relative to the gadget
    /// archive root — `assets/icon.svg` resolves to that file
    /// inside the gadget's `.torchsnap` archive (or the equivalent
    /// directory under the debug loader). The launcher renders it
    /// directly with content-type detected from the file. Absolute
    /// paths are reserved for host-produced icons (e.g. cached
    /// favicons returned by `website-metadata::lookup`); gadgets
    /// should always pass a relative path.
    asset-icon(string),
    emoji(string),
    /// Real icon of an installed application. Pass a platform-native
    /// application identifier — on macOS a bundle identifier, e.g.
    /// `com.if.Amphetamine` — and the launcher shows that
    /// application's actual icon. Requires the `icon-cache`
    /// permission in the manifest. If the application cannot be
    /// found, the entry is shown without an icon.
    app-icon(string),
  }

  /// Well-known action identifiers. Gadgets use these for
  /// standard actions so the host can assign default keybindings
  /// and icons. Use `custom` for gadget-specific actions.
  ///
  /// `open-settings` jumps to the originating gadget's own
  /// settings panel — useful as a primary action on synthetic
  /// "configuration required" entries (e.g. "API token missing —
  /// configure gadget"). The host routes the action to the
  /// settings page scoped to the gadget id that returned the entry.
  variant action-id {
    open,
    copy,
    reveal,
    open-with,
    delete,
    open-settings,
    custom(string),
  }

  record action {
    id: action-id,
    label: string,
  }
}

interface search {
  use types.{entry-icon, action-id, action};

  record catalog-entry {
    id: string,
    title: string,
    subtitle: option<string>,
    icon: option<entry-icon>,
    keywords: list<string>,
    actions: list<action>,
  }

  /// A pre-scored search result returned by query gadgets.
  /// The gadget is responsible for scoring and highlight
  /// position calculation.
  record scored-entry {
    id: string,
    title: string,
    subtitle: option<string>,
    icon: option<entry-icon>,
    score: u32,
    /// UTF-16 code unit offsets to highlight in the title.
    title-highlight-positions: list<u32>,
    /// UTF-16 code unit offsets to highlight in the subtitle.
    subtitle-highlight-positions: list<u32>,
    actions: list<action>,
    /// Opaque gadget-defined payload round-tripped by the host.
    /// Attached in `search()`, passed back in `execute()`. The
    /// host never inspects the contents.
    data: option<string>,
  }

  /// Payload for custom-ui and inline-ui search responses.
  /// The `data` field carries an optional JSON-encoded string
  /// (WIT has no opaque JSON type) forwarded to the frontend
  /// view component as-is.
  record view-response {
    view: string,
    data: option<string>,
    results: list<scored-entry>,
  }

  /// What a query gadget returns from `search()`.
  variant search-response {
    /// Gadget has nothing to contribute for this query.
    nothing,
    /// Standard scored results merged into the host's list.
    results(list<scored-entry>),
    /// Gadget requests full custom UI (replaces the result list).
    /// The host mounts the named view component registered in
    /// the gadget's frontend manifest.
    custom-ui(view-response),
    /// Gadget requests inline UI (rendered above the result list).
    /// Only one gadget can claim the inline slot per search.
    inline-ui(view-response),
  }

  enum post-action {
    nothing,
    dismiss,
    keep-open,
  }

  /// Return catalog entries for host-side fuzzy matching.
  entries: func() -> list<catalog-entry>;

  /// Gadget-driven search. Called on every query keystroke.
  /// Returns scored results directly (call-return, no streaming).
  search: func(query: string, matched-prefix: option<string>) -> search-response;

  execute: func(entry: scored-entry, action-id: action-id) -> result<post-action, string>;
}

/// Custom frontend ↔ gadget RPC.
///
/// The gadget's React frontend can call
/// `sendMessage(method, payload)` to invoke the backend on
/// demand. The host routes the call to this guest export;
/// the response is returned to the frontend's
/// `sendMessage` promise.
///
/// Both `payload` and the success arm of `result` are
/// JSON-encoded strings — same encoding convention as the
/// `settings::get` interface. The gadget parses the
/// payload with `serde_json::from_str` on the way in and
/// serializes the response on the way out.
///
/// Returning `err(string)` propagates as a Tauri command
/// error to the frontend's `sendMessage` promise (the
/// frontend sees `"gadget error: <string>"` so bridge-level
/// failures and gadget-reported failures are
/// distinguishable in logs).
///
/// **WASM gadgets cannot stream.** This export is
/// strictly request/response. Native gadgets still get the
/// full streaming `Channel<Value>` via the underlying
/// `Gadget::handle_message` trait — only the WIT bridge is
/// limited to one-shot returns. If a future WASM gadget
/// genuinely needs streaming, a `messaging-stream`
/// sub-interface can be added without breaking this one.
interface messaging {
  /// Handle a custom message from the gadget's frontend.
  handle-message: func(method: string, payload: string) -> result<string, string>;
}

/// Scheduled background tasks.
///
/// WASM has no threads — gadgets can't spawn their own
/// timers or background loops. The host runs a per-gadget
/// tokio scheduler that walks every `[[tasks]]` entry from
/// the manifest, sleeps until the earliest next fire, and
/// invokes `run-task` with the manifest-declared `task-id`
/// at the configured cadence.
///
/// Schedules are 5-field POSIX cron expressions
/// (`minute hour day month weekday`) declared in
/// `manifest.toml`:
///
///   [[tasks]]
///   id = "retention-cleanup"
///   schedule = "*/30 * * * *"
///
/// Gadgets without `[[tasks]]` ship a default no-op
/// implementation; the host never spawns a scheduler loop
/// when the manifest declares no tasks, so the cost is zero
/// for gadgets that don't use the API.
///
/// Returning `err(string)` is logged by the host and does
/// not disable the gadget — scheduled tasks are best-effort
/// background work, not lifecycle-critical.
interface tasks {
  /// Invoked by the host at the cron-scheduled time for the
  /// task with the given manifest-declared `task-id`. The
  /// gadget dispatches by name and runs whatever work the
  /// task is supposed to do.
  run-task: func(task-id: string) -> result<_, string>;
}

/// Shared host service that fetches, caches, and serves per-domain
/// website metadata (title, description, favicon).
///
/// The cache is shared across gadgets — a favicon fetched for one
/// domain by gadget A is immediately available to gadget B. Favicon
/// images are stored as host-owned files; gadgets receive an
/// `entry-icon` ready to embed in search results.
///
/// Gated by `[permissions]\nwebsite-metadata = true` in the manifest.
/// Without that flag every `lookup` returns `permission-denied`.
interface website-metadata {
  use types.{entry-icon};

  /// Selects whether `lookup` blocks on the network or returns
  /// immediately on cache miss.
  variant lookup-mode {
    /// Cache-first; never blocks. On cold miss returns `pending`
    /// and schedules a background fetch — the next call will see
    /// the populated cache. Use in latency-sensitive paths.
    cached,
    /// Cache-first; on cold miss blocks until the fetch completes
    /// or coalesces with any in-flight request for the same domain.
    /// Use when the result is load-bearing for the current render.
    blocking,
  }

  /// Cached metadata payload.
  record cache-entry {
    title: option<string>,
    description: option<string>,
    favicon: entry-icon,
  }

  /// Result of a lookup. `pending` is only ever returned in
  /// `cached` mode — `blocking` always resolves to one of the
  /// other three variants (or an error).
  variant lookup-result {
    hit(cache-entry),
    reachable-no-data,
    unreachable,
    pending,
  }

  variant website-metadata-error {
    /// The gadget manifest does not declare
    /// `[permissions]\nwebsite-metadata = true`.
    permission-denied(string),
    /// Domain string is empty, oversized, or contains characters
    /// that aren't valid in a bare domain (scheme, path, port,
    /// whitespace, ...). PSL validation is the gadget's job.
    invalid-domain(string),
  }

  /// Look up metadata for a registrable domain. `domain` must be
  /// a bare host string — no scheme, path, port, or query.
  lookup: func(domain: string, mode: lookup-mode) -> result<lookup-result, website-metadata-error>;
}

/// ─── The gadget world ───────────────────────────────────
world gadget {
  import logging;
  import clipboard;
  import sql-storage;
  import frecency;
  import settings;
  import opener;
  import http;
  import filesystem;
  import assets;
  import command;
  import platform;
  import path-resolver;
  import types;
  import website-metadata;

  export lifecycle;
  export search;
  export messaging;
  export tasks;
}
