{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Torchsnap",
  "version": "0.11.1",
  "identifier": "app.torchsnap",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**", "$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../target/bundled-gadgets/": "gadgets/",
      "icons/gadget-document.icns": "gadget-document.icns"
    },
    "fileAssociations": [
      {
        "ext": ["torchsnap"],
        "name": "Torchsnap Gadget",
        "description": "Torchsnap Gadget",
        "role": "Viewer",
        "rank": "Owner",
        "mimeType": "application/vnd.torchsnap.gadget+zip",
        "exportedType": {
          "identifier": "app.torchsnap.gadget",
          "conformsTo": ["public.data"]
        }
      }
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://torchsnap.app/updates/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4QUUxMzg4MzdERjFBQwpSV1NzOFgyRE9PR0tDV2JoUGRzdCtQc2wxakJmY1kwbHpWcUZMM3RxV05GWXlmMkFUQkFjQ1Z1WQo=",
      "requireSignedVersion": true
    }
  }
}
