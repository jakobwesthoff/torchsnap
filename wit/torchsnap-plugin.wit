/// Torchsnap Plugin Interface
///
/// Minimal initial definition covering lifecycle, catalog search,
/// query search, and execution. Expanded as real plugins are converted.
package torchsnap:plugin@0.1.0;

/// ─── Host imports (provided by the host to plugins) ─────
interface logging {
  enum log-level {
    trace,
    debug,
    info,
    warn,
    error,
  }

  log: func(level: log-level, message: string);
}

/// ─── Shared types ───────────────────────────────────────
interface types {
  variant entry-icon {
    hero-icon(string),
    data-url(string),
    asset-icon(string),
    emoji(string),
  }

  /// Well-known action identifiers. Plugins use these for
  /// standard actions so the host can assign default keybindings
  /// and icons. Use `custom` for plugin-specific actions.
  variant action-id {
    open,
    copy,
    reveal,
    open-with,
    delete,
    custom(string),
  }

  record action {
    id: action-id,
    label: string,
  }

  record catalog-entry {
    id: string,
    title: string,
    subtitle: option<string>,
    icon: option<entry-icon>,
    keywords: list<string>,
    actions: list<action>,
  }

  /// A pre-scored search result returned by query plugins.
  /// The plugin is responsible for scoring and highlight
  /// position calculation.
  record scored-entry {
    id: string,
    title: string,
    subtitle: option<string>,
    icon: option<entry-icon>,
    score: u32,
    /// UTF-16 code unit offsets to highlight in the title.
    title-highlight-positions: list<u32>,
    /// UTF-16 code unit offsets to highlight in the subtitle.
    subtitle-highlight-positions: list<u32>,
    actions: list<action>,
  }

  /// What a query plugin returns from `search()`.
  variant search-response {
    /// Plugin has nothing to contribute for this query.
    nothing,
    /// Standard scored results merged into the host's list.
    results(list<scored-entry>),
  }

  enum post-action {
    nothing,
    dismiss,
    keep-open,
  }
}

/// ─── Guest exports (implemented by plugins) ─────────────
interface lifecycle {
  enable: func();

  disable: func();
}

interface search {
  use types.{catalog-entry, action-id, post-action, search-response};

  /// Return catalog entries for host-side fuzzy matching.
  entries: func() -> list<catalog-entry>;

  /// Plugin-driven search. Called on every query keystroke.
  /// Returns scored results directly (call-return, no streaming).
  search: func(query: string, matched-prefix: option<string>) -> search-response;

  execute: func(entry-id: string, action-id: action-id) -> result<post-action, string>;
}

/// ─── The plugin world ───────────────────────────────────
world plugin {
  import logging;
  import types;

  export lifecycle;
  export search;
}
