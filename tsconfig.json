{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Ensure Vite's client types (import.meta.env, CSS modules,
     * etc.) are available. TS 6 defaults `types` to [] so this
     * must be explicit. */
    "types": ["vite/client"],

    /* Path aliases — stable import paths for plugin SDK surface.
     * Internal aliases now, real packages later. Must be kept in
     * sync with vite.config.ts resolve.alias. */
    "paths": {
      "@torchsnap/keybindings": ["./src/keybindings"],
      "@torchsnap/components": ["./src/components"],
      "@torchsnap/types": ["./src/launcher/types"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
