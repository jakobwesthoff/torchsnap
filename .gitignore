# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Repo-root `target/` holds the staging dir for bundled
# gadgets (`target/bundled-gadgets/`, populated by
# `just stage-bundled-gadgets`). Cargo does not use this
# directory because all Rust crates live under `src-tauri/`
# or `gadgets/*/` with their own `target/` dirs.
/target/

# Rust build artifacts — the gadget workspace owns a single
# `gadgets/target/` directory; per-gadget `target/` dirs are
# retained here for historical checkouts and any standalone
# work outside the workspace.
gadgets/target/
gadgets/*/target/
# Compiled WASM artifacts copied to gadget root by `just build-gadget`
gadgets/*/*.wasm
# Packaged gadget archives built by `just package-gadget`
gadgets/*.torchsnap

# Test fixture crate build artifacts — each fixture is a
# standalone wasm32-wasip2 crate with its own target/ dir.
# The committed `*.wasm` next to each fixture's Cargo.toml is
# the canonical test input, rebuilt via `just build-test-fixtures`.
src-tauri/tests/fixtures/*/target/

# Generated asset data — derived at build time, not checked in.
# Regenerate with `just asset-mascot-data`.
src/derived/mascots.json

# DuckDuckGo bang database — downloaded at build time by `just asset-bang-data`,
# ships inside the .torchsnap archive. Not checked in.
gadgets/bangs/assets/bang.json

# Python bytecode caches. `tools/mascot-size-sheet` imports
# `tools/normalize-mascot-size` as a module, which writes one next
# to the tools.
__pycache__/

# Memory benchmark output
memsnap-*.json
bench-memory-*.json
bench-memory-*.jsonl
*.snapshots.jsonl
memory-benchmark.log

