/// Torchsnap Plugin Interface
///
/// Minimal initial definition covering lifecycle, catalog search,
/// query search, and execution. Expanded as real plugins are converted.
package torchsnap:plugin@0.1.0;

/// ─── Host imports (provided by the host to plugins) ─────
interface logging {
  enum log-level {
    trace,
    debug,
    info,
    warn,
    error,
  }

  /// Structured key-value metadata pair.
  type metadata-entry = tuple<string, string>;

  /// Log a message with optional structured metadata.
  /// The optional span associates this entry with an active span.
  log: func(level: log-level, message: string, metadata: list<metadata-entry>, span: option<u64>);

  /// Start a named timing span. Returns an opaque handle.
  /// Parent allows explicit nesting — pass the parent span's handle.
  /// Metadata attached at start is merged with end-metadata on completion.
  span-start: func(name: string, parent: option<u64>, metadata: list<metadata-entry>) -> u64;

  /// End a timing span. The host computes duration and emits a timing entry.
  /// End-metadata is merged with start-metadata (end wins on key collision).
  span-end: func(span-id: u64, metadata: list<metadata-entry>);
}

/// System clipboard write access.
///
/// WASM plugins have no direct access to host APIs — they
/// can't reach `tauri_plugin_clipboard_manager` the way
/// native plugins do. This interface exposes a single
/// write-text operation so plugins can copy results to the
/// clipboard from inside `execute()`, `handle-message`, or
/// any other guest entry point.
///
/// Read access (paste, query) is intentionally NOT exposed.
/// Reading the clipboard from a sandboxed plugin would let
/// any plugin slurp arbitrary content the user has copied
/// from other applications, which is a privacy footgun.
/// Plugins that need clipboard read should stay native or
/// wait for an explicit, audited extension of this
/// interface.
interface clipboard {
  /// Write `text` to the system clipboard. Returns
  /// `err(string)` if the host's clipboard backend reports
  /// a failure.
  write-text: func(text: string) -> result<_, string>;
}

/// Per-plugin SQLite storage.
///
/// Each plugin gets an isolated database file at
/// `app_data_dir/plugins/<plugin-id>/storage.db`. The host
/// creates the file and applies the migration files declared
/// in `manifest.toml`'s `[storage.sql]` table before the
/// guest's `enable()` runs. Plugins obtain lightweight
/// connection handles via `connection()` and use them to
/// issue queries.
///
/// Plugins are responsible for scoring, ordering, and
/// `IN (...)` expansion on their side — the WIT `sql-value`
/// variant intentionally omits the host's internal `List`
/// variant. Use `serde_json` (or any other serialization)
/// to marshal complex types in and out of `text` /
/// `blob` columns.
///
/// Bridge-level failures (missing migration file, malformed
/// SQL, filesystem permission) surface as an `enable()`
/// error on the host side — the guest never sees them.
/// Per-statement errors surface from `execute` / `query`.
interface sql {
  /// A database value matching SQLite's five storage classes.
  /// Plugins build query parameters and read result rows in
  /// terms of this variant.
  variant sql-value {
    null,
    integer(s64),
    real(f64),
    text(string),
    blob(list<u8>),
  }

  resource sql-handle {
    /// Execute a statement that modifies data (INSERT,
    /// UPDATE, DELETE). Returns the number of rows
    /// affected.
    execute: func(sql: string, params: list<sql-value>) -> result<u64, string>;
    /// Execute a SELECT and return all matching rows. Each
    /// row is a list of column values matching the SELECT's
    /// column order.
    query: func(sql: string, params: list<sql-value>) -> result<list<list<sql-value>>, string>;
  }

  /// Obtain a connection handle to the plugin's database.
  /// The host initializes the database (file creation,
  /// migrations) before the guest's `enable()` runs, so
  /// this always succeeds for plugins that declare
  /// `[storage.sql]` in their manifest. The handle is
  /// released automatically via WIT resource drop semantics
  /// when the plugin lets it go out of scope.
  connection: func() -> sql-handle;
}

/// Plugin-scoped frecency tracking.
///
/// The host already records selections automatically before
/// dispatching `execute()` and applies frecency score bonuses
/// to every query plugin's results after `search()` returns
/// — neither path requires the plugin to do anything. This
/// interface exists for the narrower case of plugins that
/// need to *read* frecency state to drive their own UI, e.g.
/// the emoji picker's empty-query browse mode, which surfaces
/// the user's most-used emoji when the query is just the
/// prefix character.
///
/// All calls are namespaced to the plugin's own ID — plugins
/// cannot read other plugins' frecency data, same guarantee
/// as the `settings` interface.
interface frecency {
  /// A single item with its computed frecency score. `score`
  /// is opaque — plugins should treat it as a relative
  /// ordering key, not an absolute magnitude.
  record frecency-item {
    item-id: string,
    score: u32,
  }

  /// Whether frecency tracking is currently enabled. When
  /// false, `top-items` always returns empty and any
  /// frecency-driven UI should fall back to a static order.
  is-enabled: func() -> bool;

  /// Top-N items by frecency score, highest first. Items
  /// with zero score are omitted. Returns an empty list
  /// when frecency is disabled or no history exists.
  top-items: func(limit: u32) -> list<frecency-item>;
}

/// Read settings from this plugin's namespace.
///
/// Plugins are confined to keys under `plugins.<plugin-id>.`
/// — the host strips the prefix transparently. There is no
/// way to read other plugins' settings or host-level keys.
///
/// Returned values are JSON-encoded strings (`true`, `42`,
/// `"hello"`, `{"a":1}`, …) so any TOML-compatible value
/// shape can cross the WIT boundary without inventing a
/// dedicated value variant. The plugin parses the JSON
/// into whatever shape it expects.
///
/// `none` means the key has never been set in the store,
/// neither by the manifest's `[settings]` defaults nor by a
/// runtime write. Plugins typically fall back to a hard-coded
/// default in that case (the same default that lives in
/// `manifest.toml`).
interface settings {
  /// Returns the JSON-encoded value for `key`, or `none` if unset.
  /// `key` is relative to the plugin's namespace.
  get: func(key: string) -> option<string>;
}

/// Opens a URL in the OS default handler (browser, mail client, etc.).
///
/// WASM plugins have no direct access to Tauri's opener APIs. This interface
/// exposes a single `open-url` operation — the only case WASM plugins need
/// today. `reveal-path` (Show in Finder/Explorer) is tracked separately and
/// deferred until the `app-launcher` conversion is underway.
///
/// Plugins declare which URL schemes they are allowed to open under
/// `[permissions.opener]` in `manifest.toml`. The host enforces this at
/// call time — any scheme not listed returns `err("scheme not permitted:
/// {scheme}")`. Omitting `[permissions.opener]` entirely means the plugin
/// has no `open-url` access (deny by default).
///
/// ```toml
/// [permissions.opener]
/// schemes = ["https", "http"]
/// ```
interface opener {
  /// Open `url` in the OS default handler. Returns `err(string)` if the
  /// scheme is not in the plugin's declared allowlist, or if the host's
  /// opener backend reports a failure.
  open-url: func(url: string) -> result<_, string>;
}

/// Minimal synchronous HTTP client for WASM plugins.
///
/// WASM plugins have no async runtime, so `fetch` is a blocking host call
/// executed on the host's thread pool. Plugins declare allowed origins under
/// `[permissions.http]` in `manifest.toml`. The host enforces this at call
/// time. The special origin `"*"` opts the plugin into trust-all mode.
///
/// ```toml
/// [permissions.http]
/// origins = ["https://api.duckduckgo.com"]
///
/// # or trust-all:
/// origins = ["*"]
/// ```
interface http {
  /// HTTP method. The six common methods are named variants; `other(string)`
  /// covers non-standard methods (WebDAV, etc.) without exposing the common
  /// cases to typos.
  variant http-method {
    get,
    post,
    put,
    patch,
    delete,
    head,
    other(string),
  }

  /// A synchronous HTTP request issued by a WASM plugin through the host.
  ///
  /// `timeout-ms: none` delegates to the host default. `max-body-size: none`
  /// delegates to the host default (guards against unbounded downloads).
  record http-request {
    url: string,
    method: http-method,
    headers: list<tuple<string, string>>,
    body: option<list<u8>>,
    timeout-ms: option<u32>,
    max-body-size: option<u64>,
  }

  /// The HTTP response returned to a WASM plugin.
  record http-response {
    status: u16,
    headers: list<tuple<string, string>>,
    body: list<u8>,
  }

  /// Error variants for `fetch`. There are exactly three categories;
  /// any real transport failure fits `network`.
  variant http-error {
    /// The request URL's origin is not in the plugin's declared allowlist.
    permission-denied(string),
    /// A connection-level failure: DNS, TLS, refused connection, invalid
    /// method string, or any other transport error.
    network(string),
    /// The request exceeded the configured or host-default timeout.
    timeout,
  }

  /// Execute an HTTP request and return the full response. The call blocks
  /// until the response body is fully received or an error occurs.
  fetch: func(request: http-request) -> result<http-response, http-error>;
}

/// ─── Guest exports (implemented by plugins) ─────────────
interface lifecycle {
  enable: func();

  disable: func();

  /// Called by the host whenever a setting in this plugin's
  /// namespace changes. `key` is relative (matching the
  /// `settings::get` argument); `value` is the new
  /// JSON-encoded value, same encoding as `settings::get`.
  ///
  /// The host's existing CoalescingDispatcher (ADR 0026)
  /// runs *before* the change reaches the plugin, so rapid
  /// successive writes to the same key are deduplicated to
  /// the most recent value before this callback fires.
  on-setting-changed: func(key: string, value: string);
}

interface search {
  variant entry-icon {
    hero-icon(string),
    data-url(string),
    asset-icon(string),
    emoji(string),
  }

  /// Well-known action identifiers. Plugins use these for
  /// standard actions so the host can assign default keybindings
  /// and icons. Use `custom` for plugin-specific actions.
  variant action-id {
    open,
    copy,
    reveal,
    open-with,
    delete,
    custom(string),
  }

  record action {
    id: action-id,
    label: string,
  }

  record catalog-entry {
    id: string,
    title: string,
    subtitle: option<string>,
    icon: option<entry-icon>,
    keywords: list<string>,
    actions: list<action>,
  }

  /// A pre-scored search result returned by query plugins.
  /// The plugin is responsible for scoring and highlight
  /// position calculation.
  record scored-entry {
    id: string,
    title: string,
    subtitle: option<string>,
    icon: option<entry-icon>,
    score: u32,
    /// UTF-16 code unit offsets to highlight in the title.
    title-highlight-positions: list<u32>,
    /// UTF-16 code unit offsets to highlight in the subtitle.
    subtitle-highlight-positions: list<u32>,
    actions: list<action>,
  }

  /// Payload for custom-ui and inline-ui search responses.
  /// The `data` field carries an optional JSON-encoded string
  /// (WIT has no opaque JSON type) forwarded to the frontend
  /// view component as-is.
  record view-response {
    view: string,
    data: option<string>,
    results: list<scored-entry>,
  }

  /// What a query plugin returns from `search()`.
  variant search-response {
    /// Plugin has nothing to contribute for this query.
    nothing,
    /// Standard scored results merged into the host's list.
    results(list<scored-entry>),
    /// Plugin requests full custom UI (replaces the result list).
    /// The host mounts the named view component registered in
    /// the plugin's frontend manifest.
    custom-ui(view-response),
    /// Plugin requests inline UI (rendered above the result list).
    /// Only one plugin can claim the inline slot per search.
    inline-ui(view-response),
  }

  enum post-action {
    nothing,
    dismiss,
    keep-open,
  }

  /// Return catalog entries for host-side fuzzy matching.
  entries: func() -> list<catalog-entry>;

  /// Plugin-driven search. Called on every query keystroke.
  /// Returns scored results directly (call-return, no streaming).
  search: func(query: string, matched-prefix: option<string>) -> search-response;

  execute: func(entry-id: string, action-id: action-id) -> result<post-action, string>;
}

/// Custom frontend ↔ plugin RPC.
///
/// The plugin's React frontend can call
/// `sendMessage(method, payload)` to invoke the backend on
/// demand. The host routes the call to this guest export;
/// the response is returned to the frontend's
/// `sendMessage` promise.
///
/// Both `payload` and the success arm of `result` are
/// JSON-encoded strings — same encoding convention as the
/// `settings::get` interface. The plugin parses the
/// payload with `serde_json::from_str` on the way in and
/// serializes the response on the way out.
///
/// Returning `err(string)` propagates as a Tauri command
/// error to the frontend's `sendMessage` promise (the
/// frontend sees `"plugin error: <string>"` so bridge-level
/// failures and plugin-reported failures are
/// distinguishable in logs).
///
/// **WASM plugins cannot stream.** This export is
/// strictly request/response. Native plugins still get the
/// full streaming `Channel<Value>` via the underlying
/// `Plugin::handle_message` trait — only the WIT bridge is
/// limited to one-shot returns. If a future WASM plugin
/// genuinely needs streaming, a `messaging-stream`
/// sub-interface can be added without breaking this one.
interface messaging {
  /// Handle a custom message from the plugin's frontend.
  handle-message: func(method: string, payload: string) -> result<string, string>;
}

/// Scheduled background tasks.
///
/// WASM has no threads — plugins can't spawn their own
/// timers or background loops. The host runs a per-plugin
/// tokio scheduler that walks every `[[tasks]]` entry from
/// the manifest, sleeps until the earliest next fire, and
/// invokes `run-task` with the manifest-declared `task-id`
/// at the configured cadence.
///
/// Schedules are 5-field POSIX cron expressions
/// (`minute hour day month weekday`) declared in
/// `manifest.toml`:
///
///   [[tasks]]
///   id = "retention-cleanup"
///   schedule = "*/30 * * * *"
///
/// Plugins without `[[tasks]]` ship a default no-op
/// implementation; the host never spawns a scheduler loop
/// when the manifest declares no tasks, so the cost is zero
/// for plugins that don't use the API.
///
/// Returning `err(string)` is logged by the host and does
/// not disable the plugin — scheduled tasks are best-effort
/// background work, not lifecycle-critical.
interface tasks {
  /// Invoked by the host at the cron-scheduled time for the
  /// task with the given manifest-declared `task-id`. The
  /// plugin dispatches by name and runs whatever work the
  /// task is supposed to do.
  run-task: func(task-id: string) -> result<_, string>;
}

/// ─── The plugin world ───────────────────────────────────
world plugin {
  import logging;
  import settings;
  import sql;
  import clipboard;
  import frecency;
  import opener;
  import http;

  export lifecycle;
  export search;
  export messaging;
  export tasks;
}
