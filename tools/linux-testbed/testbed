# Mac side of the Linux testbed: every `just testbed-*` recipe calls this
# script with a subcommand. It finds the test machine through
# TORCHSNAP_LINUX_HOST and moves code and results between the Mac and the
# machine; the work on the machine itself is done by scripts in the
# synced tree. See docs/Howto-test-on-a-raspberry-pi.md.
#
# Usage:
#   testbed sync              mirror the working tree to ~/torchsnap on the machine
#   testbed provision [ARGS]  sync, then run the provision script there
#   testbed reboot            reboot the machine, wait until its session is ready
#   testbed exec COMMAND      run one shell command line on the machine
#   testbed build [--on-machine]
#                             sync, build a debug app in the Mac's Linux
#                             container and copy it there (--on-machine:
#                             build gadgets and a debug app there)
#   testbed app-start         start the debug app in the machine's desktop session
#   testbed app-stop          stop it
#   testbed app-log [LINES]   print the end of its output
#   testbed control METHOD [JSON]  one request to the app's control socket
#   testbed eval JS           print the value of JS evaluated in the desktop shell
#   testbed windows           the app's windows on the machine, as JSON
#   testbed launcher-state    whether the launcher is visible and focused, and its monitor
#   testbed screenshot NAME [--monitor N | --window REGEX | --area X,Y,W,H]
#                             take a screenshot, copy it to target/linux-testbed/NAME.png
#   testbed type (--window REGEX | --shell-modal) TEXT    type into that target
#   testbed key (--window REGEX | --shell-modal) KEY...   press keys (Escape, ctrl+u, ...)
#   testbed pointer X Y       move the pointer (logical pixels)
#   testbed click X Y [left|right|middle]
#
#   testbed clipboard-set TEXT
#   testbed clipboard-get
#   testbed tray on|off|status  the desktop's tray support (GNOME: AppIndicator extension)
#   testbed tray-icon         position of the app's tray icon, and whether its menu is open
#   testbed tray-click [left|right|middle]
#   testbed headless-start [WxH@SCALE...]  a headless GNOME session with virtual monitors
#   testbed headless-stop     stop it and the app in it
#   testbed stop-all          stop the app, a benchmark's app, recordings and headless sessions
#   testbed record-start NAME start recording the machine's screen
#   testbed record-stop       stop, copy the recording to target/linux-testbed/
#
#   type and key refuse (exit 4) unless the target has the keyboard.
#   app-start, app-stop, app-log, control, eval, windows, launcher-state
#   and screenshot take --headless to work in the headless session.
#
# Commands on the machine run through `bash -c`, or, when
# TORCHSNAP_LINUX_RUNNER is set, after that prefix (for example a
# terminal on the machine's screen that shows every command it runs).

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
readonly repo_root

# The tree lives in the login user's home on the machine. rsync resolves
# a relative remote path against that home.
readonly remote_tree="torchsnap"

usage() {
    sed -n '/^# Usage:/,/^$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
    exit 2
}

# The repository never names a machine, so every subcommand that talks to
# one needs the variable.
require_host() {
    if [ -z "${TORCHSNAP_LINUX_HOST:-}" ]; then
        echo "testbed: TORCHSNAP_LINUX_HOST is not set (example: user@pi.local)" >&2
        exit 2
    fi
}

# =========================================================
# Running commands on the machine
# =========================================================

# run_remote COMMAND: runs one shell command line on the machine.
#
# ssh joins its arguments and the login shell on the machine parses them
# once more, so the command line goes over as a single quoted word: the
# far side then runs exactly COMMAND, through `bash -c` or after the
# runner prefix. A runner such as testbed-run joins and evals its
# arguments, which unwraps the quoting the same way.
run_remote() {
    local quoted
    quoted="$(printf '%q' "$1")"
    local status=0
    # The command line is meant to be built here and sent finished.
    # shellcheck disable=SC2029
    if [ -n "${TORCHSNAP_LINUX_RUNNER:-}" ]; then
        ssh "$TORCHSNAP_LINUX_HOST" "$TORCHSNAP_LINUX_RUNNER $quoted" || status=$?
        # testbed-run, the runner this was written for, refuses with 75
        # when the terminal pane it would use is still busy.
        if [ "$status" -eq 75 ]; then
            echo "testbed: runner refused (exit 75), its window is busy" >&2
        fi
    else
        ssh "$TORCHSNAP_LINUX_HOST" "bash -c $quoted" || status=$?
    fi
    return "$status"
}

# run_direct COMMAND: runs a command line on the machine without the
# runner. For the reboot and the checks around it: a runner that shows
# commands in a terminal on the machine's screen goes down with the
# desktop when the machine reboots.
#
# While the machine is down, a connection attempt would otherwise hang
# for the system's TCP timeout instead of failing fast.
run_direct() {
    # shellcheck disable=SC2029
    ssh -o ConnectTimeout=5 "$TORCHSNAP_LINUX_HOST" "bash -c $(printf '%q' "$1")"
}

# shell_words WORD...: the words as one command line, each quoted.
shell_words() {
    local word
    local line=""
    for word in "$@"; do
        line="$line $(printf '%q' "$word")"
    done
    printf '%s' "${line# }"
}

# =========================================================
# sync
# =========================================================

# The machine builds from a copy of the working tree, including changes
# not yet committed. Files that .gitignore names (target/, node_modules/,
# built gadgets) stay out, so the machine builds its own. --delete removes
# files deleted on the Mac but keeps ignored files on the machine, since
# rsync protects excluded paths from deletion; the machine's build output
# survives a sync.
#
# `rsync_command` is the rsync on PATH unless a build in the container
# has picked one with zstd, which then copies the tree as well.
rsync_command=rsync

cmd_sync() {
    "$rsync_command" -a --delete --filter=':- .gitignore' --exclude=.git \
        "$repo_root/" "$TORCHSNAP_LINUX_HOST:$remote_tree/"
}

# =========================================================
# provision
# =========================================================

# The provision script runs from the synced tree, so the machine gets the
# steps as they are in the working tree. `$HOME` expands on the machine.
cmd_provision() {
    cmd_sync
    # shellcheck disable=SC2016
    local command='"$HOME"/torchsnap/tools/linux-testbed/provision/provision'
    if [ $# -gt 0 ]; then
        command="$command $(shell_words "$@")"
    fi

    # Steps that need the desktop session are deferred while the machine
    # still runs another session (exit 3). The desktop's display manager
    # takes over at the next boot, and the second run inside its session
    # does the rest.
    local status=0
    run_remote "$command" || status=$?
    if [ "$status" -ne 3 ]; then
        return "$status"
    fi
    echo "testbed: steps need the desktop session; rebooting into it"
    cmd_reboot
    status=0
    run_remote "$command" || status=$?
    if [ "$status" -eq 3 ]; then
        echo "testbed: steps still deferred after the reboot; the desktop session did not start" >&2
        return 1
    fi
    return "$status"
}

# =========================================================
# Subcommands that run in the synced tree
# =========================================================

# run_pi SUBCOMMAND [ARGS...]: runs testbed-pi on the machine, after
# checking that the tree is there. The command line is single-quoted, so
# `$HOME` and `$pi` expand on the machine.
# shellcheck disable=SC2016
run_pi() {
    local command='pi="$HOME/torchsnap/tools/linux-testbed/pi/testbed-pi"; '
    command="$command"'if [ ! -x "$pi" ]; then echo "testbed: no synced tree on the machine; run just testbed-sync first" >&2; exit 2; fi; '
    command="$command"'exec "$pi" '"$(shell_words "$@")"
    run_remote "$command"
}

# =========================================================
# build
# =========================================================

# The container build's output on the Mac (tools/linux-build) and where
# it goes in the machine's tree: next to the synced sources, under the
# gitignored `target/`, which a sync leaves alone.
readonly deploy_path="target/linux-build/debug"

# find_zstd_rsync: prints the first rsync on PATH whose `--version` lists
# zstd among its compressions. macOS's own /usr/bin/rsync is openrsync,
# which has no `--compress-choice`. The output is read whole before it is
# searched: a grep that stops early would end rsync with SIGPIPE, which
# pipefail turns into a failure.
find_zstd_rsync() {
    local candidate version
    while IFS= read -r candidate; do
        version="$("$candidate" --version 2>/dev/null)" || continue
        if grep -qw zstd <<<"$version"; then
            printf '%s' "$candidate"
            return 0
        fi
    done < <(type -a -P rsync)
    return 1
}

# The container on the Mac builds and copies a one-line change in less
# than half the time the machine takes to build it, so it is the default
# (docs/Howto-test-on-a-raspberry-pi.md has the measurements). The build runs at the path of the machine's
# tree, which a debug binary looks in for development gadgets
# (`CARGO_MANIFEST_DIR/../gadgets`). The machine clears its record of the
# current build before anything changes and writes it once the copy is
# complete, so `app-start` never runs a build that failed or is half
# copied.
cmd_build_in_container() {
    if ! rsync_command="$(find_zstd_rsync)"; then
        echo "testbed: no rsync with zstd compression on PATH (macOS's /usr/bin/rsync is openrsync, which has none);" \
            "install rsync 3, for example with Homebrew, or build on the machine with just testbed-build --on-machine" >&2
        exit 2
    fi
    cmd_sync

    # A runner may print lines of its own, so the last line counts.
    local output tree
    output="$(run_pi deploy-start)"
    tree="$(tail -n 1 <<<"$output")"
    case "$tree" in
        /*) ;;
        *)
            echo "testbed: the machine did not report its tree's path; it answered: $output" >&2
            return 1
            ;;
    esac

    TORCHSNAP_LINUX_BUILD_WORKDIR="$tree" "$repo_root/tools/linux-build/linux-build" build

    local start=$SECONDS
    "$rsync_command" -a --delete --compress --compress-choice=zstd \
        "$repo_root/$deploy_path/" "$TORCHSNAP_LINUX_HOST:$remote_tree/$deploy_path/"
    echo "testbed: copied $deploy_path to the machine in $((SECONDS - start)) s"
    run_pi deploy-finish
}

cmd_build() {
    case "$*" in
        "") cmd_build_in_container ;;
        --on-machine)
            cmd_sync
            run_pi build
            ;;
        *) usage ;;
    esac
}

# =========================================================
# Files from the machine
# =========================================================

# Screenshots and recordings land next to the repository's other build
# output, which git ignores.
readonly local_results="$repo_root/target/linux-testbed"

# fetch REMOTE_PATH: copies a file from the machine and prints the local
# path.
fetch() {
    local remote_path="$1"
    mkdir -p "$local_results"
    local local_path
    local_path="$local_results/$(basename "$remote_path")"
    scp -q "$TORCHSNAP_LINUX_HOST:$remote_path" "$local_path"
    echo "$local_path"
}

# The machine prints the screenshot's path as the last line of its output.
cmd_screenshot() {
    local output
    output="$(run_pi screenshot "$@")" || { echo "$output"; return 1; }
    fetch "$(tail -n 1 <<<"$output")"
}

# The machine prints the finished recording's path last.
cmd_record_stop() {
    local output
    output="$(run_pi record-stop)" || { echo "$output"; return 1; }
    fetch "$(tail -n 1 <<<"$output")"
}

# =========================================================
# reboot
# =========================================================

# The machine counts as back when its boot id has changed and the desktop
# session is ready for input (testbed-pi session-ready).
cmd_reboot() {
    local timeout="${TORCHSNAP_LINUX_REBOOT_TIMEOUT:-300}"
    local interval="${TORCHSNAP_LINUX_POLL_INTERVAL:-5}"
    local boot_id_command='cat /proc/sys/kernel/random/boot_id'
    # shellcheck disable=SC2016
    local ready_command='"$HOME"/torchsnap/tools/linux-testbed/pi/testbed-pi session-ready'

    local old_boot_id
    old_boot_id="$(run_direct "$boot_id_command")"
    # The machine may go down before the command returns; ssh then exits
    # 255 for the closed connection, which counts as a reboot under way.
    local status=0
    run_direct 'sudo systemctl --no-block reboot' || status=$?
    if [ "$status" -ne 0 ] && [ "$status" -ne 255 ]; then
        echo "testbed: the reboot command failed (exit $status)" >&2
        return 1
    fi

    local deadline=$((SECONDS + timeout))
    local boot_id=""
    while [ "$SECONDS" -lt "$deadline" ]; do
        sleep "$interval"
        boot_id="$(run_direct "$boot_id_command" 2>/dev/null)" || continue
        [ -n "$boot_id" ] && [ "$boot_id" != "$old_boot_id" ] && break
    done
    if [ -z "$boot_id" ] || [ "$boot_id" = "$old_boot_id" ]; then
        echo "testbed: the machine did not come back within ${timeout}s" >&2
        return 1
    fi

    until run_direct "$ready_command" >/dev/null 2>&1; do
        if [ "$SECONDS" -ge "$deadline" ]; then
            echo "testbed: the machine is back, but its session not ready within ${timeout}s:" >&2
            run_direct "$ready_command" >&2 || true
            return 1
        fi
        sleep "$interval"
    done
    echo "testbed: the machine is back and its session is ready"
}

# =========================================================
# Dispatch
# =========================================================

[ $# -gt 0 ] || usage
subcommand="$1"
shift

case "$subcommand" in
    provision)
        require_host
        cmd_provision "$@"
        ;;
    reboot)
        require_host
        cmd_reboot
        ;;
    exec)
        require_host
        [ $# -eq 1 ] || usage
        run_remote "$1"
        ;;
    build)
        require_host
        cmd_build "$@"
        ;;
    app-start | app-stop | app-log | control | eval | windows | launcher-state | type | key | pointer | click | clipboard-set | clipboard-get | tray | tray-icon | tray-click | record-start | headless-start | headless-stop | stop-all)
        require_host
        run_pi "$subcommand" "$@"
        ;;
    screenshot)
        require_host
        cmd_screenshot "$@"
        ;;
    record-stop)
        require_host
        cmd_record_stop
        ;;
    sync)
        require_host
        cmd_sync "$@"
        ;;
    *)
        usage
        ;;
esac
