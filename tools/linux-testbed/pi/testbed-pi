# Machine side of the Linux testbed: runs on the test machine from the
# synced tree and does the work the Mac-side `testbed` script asks for.
# What differs between desktops lives in desktop-<name>.sh next to this
# script, chosen by the session's XDG_CURRENT_DESKTOP.
#
# Usage:
#   testbed-pi env                    print the session variables the testbed uses
#   testbed-pi session-ready          exit 0 once the desktop session takes input
#   testbed-pi build                  install dependencies, build gadgets and a debug app,
#                                     record it as the current build
#   testbed-pi deploy-start           forget the current build before the Mac copies
#                                     its build here; print the tree's path
#   testbed-pi deploy-finish          take the copied build's gadgets, record it as current
#   testbed-pi app-start              start the current build in the desktop session
#   testbed-pi app-stop               stop it
#   testbed-pi app-log [LINES]        print the end of its output (default 100 lines)
#   testbed-pi control METHOD [JSON]  one request to the app's control socket
#   testbed-pi merge-app-settings     enable the control socket, skip the welcome
#   testbed-pi bench-memory -d TEXT [--cycles N] [--timing-cycles N]
#                                     run tools/bench-memory with the current build
#   testbed-pi eval JS                print the value of JS evaluated in the desktop shell
#   testbed-pi windows                the app's windows as JSON
#   testbed-pi launcher-state         {"visible", "focused", "monitor"} of the launcher
#   testbed-pi screenshot NAME [--monitor N | --window REGEX | --area X,Y,W,H]
#                                     take a screenshot, print its path
#   testbed-pi type (--window REGEX | --shell-modal) TEXT
#                                     type TEXT into the named target
#   testbed-pi key (--window REGEX | --shell-modal) KEY...
#                                     press keys or combinations (Escape, ctrl+u, ...)
#   testbed-pi pointer X Y            move the pointer to X,Y (logical pixels)
#   testbed-pi click X Y [left|right|middle]
#                                     move there and click
#
#   app-start, app-stop, app-log, control, eval, windows, launcher-state,
#   screenshot and bench-memory take --headless to work in the headless
#   session.
#   testbed-pi tray on|off|status     switch or report the desktop's tray support
#   testbed-pi tray-icon              {"x", "y", "width", "height", "menuOpen"} of the app's tray icon
#   testbed-pi tray-click [left|right|middle]
#                                     click the app's tray icon
#   testbed-pi headless-start [WxH@SCALE...]
#                                     start a headless GNOME session (default 1280x800@1 2560x1600@2)
#   testbed-pi headless-stop          stop it and the app in it
#   testbed-pi stop-all               stop every testbed unit, put the recorded tray state back
#   testbed-pi record-start NAME      start recording the screen, print the file
#   testbed-pi record-stop            stop it, print the file once it is complete
#   testbed-pi clipboard-set TEXT     put TEXT on the clipboard
#   testbed-pi clipboard-get          print the clipboard's text

# shellcheck source-path=SCRIPTDIR
set -euo pipefail

pi_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
tree_dir="$(cd "$pi_dir/../../.." && pwd)"
readonly pi_dir tree_dir

# Runtime files of the testbed: logs, screenshots, recordings.
readonly state_dir="$HOME/.cache/torchsnap-testbed"

# How often waits poll, in seconds; the tests shorten it.
readonly poll_interval="${TORCHSNAP_TESTBED_POLL_INTERVAL:-1}"

usage() {
    sed -n '/^# Usage:/,/^$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
    exit 2
}

# Commands run over SSH do not get the PATH entries the installers add to
# the shell profile.
export PATH="$HOME/.cargo/bin:$HOME/.bun/bin:$HOME/.local/bin:$PATH"

# =========================================================
# The desktop session's environment
# =========================================================

# A command run over SSH has the session bus but not the display: no
# WAYLAND_DISPLAY, DISPLAY, XAUTHORITY or XDG_CURRENT_DESKTOP. The desktop
# session hands those to the systemd user manager, so they are read from
# there; a command through a runner and one through plain SSH then see
# the same session.
session_env() {
    XDG_RUNTIME_DIR="/run/user/$(id -u)"
    export XDG_RUNTIME_DIR
    local line name
    while IFS= read -r line; do
        name="${line%%=*}"
        case "$name" in
            WAYLAND_DISPLAY | DISPLAY | XAUTHORITY | DBUS_SESSION_BUS_ADDRESS | XDG_CURRENT_DESKTOP)
                export "$name=${line#*=}"
                ;;
        esac
    done < <(systemctl --user show-environment)
}

print_session_env() {
    local name
    for name in WAYLAND_DISPLAY DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS XDG_CURRENT_DESKTOP; do
        echo "$name=${!name:-}"
    done
}

load_desktop() {
    case "${XDG_CURRENT_DESKTOP:-}" in
        GNOME)
            source "$pi_dir/desktop-gnome.sh"
            ;;
        *)
            echo "testbed-pi: no testbed support for desktop ${XDG_CURRENT_DESKTOP:-(none)} yet" >&2
            exit 2
            ;;
    esac
}

# wait_for TIMEOUT COMMAND...: runs COMMAND every poll_interval seconds
# until it succeeds; fails after TIMEOUT seconds.
wait_for() {
    local deadline=$((SECONDS + $1))
    shift
    until "$@" >/dev/null 2>&1; do
        [ "$SECONDS" -lt "$deadline" ] || return 1
        sleep "$poll_interval"
    done
}

# =========================================================
# Build
# =========================================================

# Two builds can be on the machine: one built here (`build`) and one the
# Mac built in its Linux container and copied into the tree's `target/`
# (`deploy-start`, the copy, `deploy-finish`). The record names the one
# that finished last, and `app-start` runs only that one. Every build
# removes the record before it changes anything and writes it once it
# has succeeded, so after a failed or interrupted build there is no
# current build and `app-start` refuses instead of running an older one.
readonly current_build_record="$state_dir/current-build"
readonly deploy_dir="$tree_dir/target/linux-build/debug"

# build_binary KIND: the binary of the build the record names.
build_binary() {
    case "$1" in
        container) echo "$deploy_dir/bin/torchsnap" ;;
        machine) echo "$tree_dir/src-tauri/target/debug/torchsnap" ;;
        *) return 1 ;;
    esac
}

record_build() {
    mkdir -p "$state_dir"
    echo "$1" >"$current_build_record"
}

# `just install` runs every time: after a lockfile change the build
# needs the new packages.
cmd_build() {
    rm -f "$current_build_record"
    cd "$tree_dir"
    just install
    just build --config '{"bundle":{"active":false}}'
    record_build machine
}

# The Mac builds at the path this prints and then copies its output to
# `deploy_dir`.
cmd_deploy_start() {
    rm -f "$current_build_record"
    mkdir -p "$(dirname "$deploy_dir")"
    echo "$tree_dir"
}

# A debug binary loads development gadgets from the tree's `gadgets/`, as
# the archives a build leaves there. The copied build brings those of
# the gadgets `gadgets/bundled.toml` does not list; the listed ones are
# in its `lib/`, which the app reads first. Archives from an earlier
# build go, so the tree holds exactly the copied build's.
cmd_deploy_finish() {
    if [ ! -x "$deploy_dir/bin/torchsnap" ] || [ ! -d "$deploy_dir/dev-gadgets" ]; then
        echo "testbed-pi: incomplete deploy in $deploy_dir (needs bin/torchsnap and dev-gadgets/); run just testbed-build" >&2
        return 1
    fi
    mkdir -p "$tree_dir/gadgets"
    rm -f "$tree_dir"/gadgets/*.torchsnap
    local archive
    for archive in "$deploy_dir"/dev-gadgets/*.torchsnap; do
        [ -f "$archive" ] || continue
        cp -p "$archive" "$tree_dir/gadgets/"
    done
    record_build container
}

# =========================================================
# The app
# =========================================================

readonly app_timeout="${TORCHSNAP_TESTBED_APP_TIMEOUT:-60}"

# The binary app-start runs: the current build, or
# TORCHSNAP_TESTBED_APP_BINARY when set (the tests use it).
current_app_binary() {
    if [ -n "${TORCHSNAP_TESTBED_APP_BINARY:-}" ]; then
        echo "$TORCHSNAP_TESTBED_APP_BINARY"
        return
    fi
    if [ ! -s "$current_build_record" ]; then
        echo "testbed-pi: no current build on the machine; run just testbed-build" >&2
        return 1
    fi
    local kind binary
    kind="$(cat "$current_build_record")"
    if ! binary="$(build_binary "$kind")"; then
        echo "testbed-pi: unknown build '$kind' in $current_build_record; run just testbed-build" >&2
        return 1
    fi
    if [ ! -x "$binary" ]; then
        echo "testbed-pi: the current build ($kind) is missing at $binary; run just testbed-build" >&2
        return 1
    fi
    echo "$binary"
}

# The app in the desktop session, or in the headless session (--headless;
# see `use_headless_session`, which also points XDG_DATA_HOME at the
# headless app's own data directory).
app_unit="torchsnap-testbed-app"
app_log="$state_dir/app.log"

# Tauri keeps the app's data under the identifier from tauri.conf.json
# in the XDG data directory.
app_data_dir() {
    echo "${XDG_DATA_HOME:-$HOME/.local/share}/app.torchsnap"
}

control_socket() {
    echo "$(app_data_dir)/control.sock"
}

# The app's settings store keeps each setting under a flat key with dots
# in it (src-tauri/src/lib.rs, `.ensure("controlChannel.enabled", ...)`),
# not as nested objects. The control socket is off by default and the
# welcome window covers the launcher on a first start; these two keys
# switch the socket on and mark the welcome as seen. Every other setting
# stays as it is.
readonly welcome_revision=1 # WELCOME_REVISION in src-tauri/src/welcome.rs

cmd_merge_app_settings() {
    local file
    file="$(app_data_dir)/settings.json"
    mkdir -p "$(dirname "$file")"
    [ -s "$file" ] || echo '{}' >"$file"
    jq --argjson revision "$welcome_revision" \
        '. + {"controlChannel.enabled": true, "welcome.seenRevision": $revision}' \
        "$file" >"$file.tmp"
    mv "$file.tmp" "$file"
}

app_running() {
    systemctl --user is-active --quiet "$app_unit"
}

# The app runs as a transient systemd user unit: it outlives the SSH call
# that started it, it gets the desktop session's environment from the
# user manager, and stopping the unit ends every process it started.
cmd_app_start() {
    if app_running; then
        echo "testbed-pi: the app is already running ($app_unit)" >&2
        return 1
    fi
    local app_binary
    app_binary="$(current_app_binary)" || return 1
    [ -x "$app_binary" ] || { echo "testbed-pi: no debug build at $app_binary; run just testbed-build" >&2; return 1; }
    cmd_merge_app_settings
    mkdir -p "$state_dir"
    echo "=== app-start $(date '+%F %T')" >>"$app_log"
    local session=()
    if [ -n "$headless" ]; then
        # The user manager's environment points at the desktop session;
        # the headless app gets the headless session's display and bus
        # and its own data, settings and cache instead.
        session=(env -u DISPLAY -u XAUTHORITY
            "WAYLAND_DISPLAY=$WAYLAND_DISPLAY" GDK_BACKEND=wayland
            "DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS"
            "XDG_DATA_HOME=$XDG_DATA_HOME" "XDG_CONFIG_HOME=$XDG_CONFIG_HOME" "XDG_CACHE_HOME=$XDG_CACHE_HOME")
    fi
    systemd-run --user --unit "$app_unit" --collect --quiet \
        -p "StandardOutput=append:$app_log" -p "StandardError=append:$app_log" \
        ${session[@]+"${session[@]}"} "$app_binary"
    if ! wait_for "$app_timeout" control_request status; then
        echo "testbed-pi: the app's control socket did not answer within ${app_timeout}s; last log lines:" >&2
        tail -n 20 "$app_log" >&2
        return 1
    fi
}

cmd_app_stop() {
    if app_running; then
        systemctl --user stop "$app_unit"
    fi
    wait_for 30 bash -c "! systemctl --user is-active --quiet $app_unit"
}

cmd_app_log() {
    tail -n "${1:-100}" "$app_log"
}

# =========================================================
# Control socket
# =========================================================

control_request() {
    "$pi_dir/control-request" "$(control_socket)" "$@"
}

# The first `show` after a start fails until the launcher's frontend has
# reported its layout (src-tauri/src/control/handlers/launcher.rs); only
# that error is waited out.
readonly layout_not_ready="launcher layout not yet received from frontend"

cmd_control() {
    [ $# -ge 1 ] || usage
    local response status=0
    response="$(control_request "$@")" || status=$?
    if [ "$1" = "show" ]; then
        local deadline=$((SECONDS + 60))
        while [ "$status" -eq 1 ] && [[ "$response" == *"$layout_not_ready"* ]] && [ "$SECONDS" -lt "$deadline" ]; do
            sleep "$poll_interval"
            status=0
            response="$(control_request "$@")" || status=$?
        done
    fi
    echo "$response"
    return "$status"
}

# =========================================================
# Observing
# =========================================================

# The launcher's state from two places: whether it is shown, from the app
# (control `status`); whether it has keyboard focus and on which monitor
# it is, from the desktop. When the control API learns to report the
# latter two, this is the one place that changes.
cmd_launcher_state() {
    local status windows
    status="$(control_request status)" || { echo "$status" >&2; return 1; }
    windows="$(desk_app_windows)" || return 1
    python3 -c '
import json, sys
status = json.loads(sys.argv[1])["result"]
launcher = next((w for w in json.loads(sys.argv[2]) if w["title"] == ""), None)
print(json.dumps({
    "visible": status["visible"],
    "focused": bool(launcher and launcher["focused"]),
    "monitor": launcher["monitor"] if launcher else None,
}))
' "$status" "$windows"
}

readonly shots_dir="$state_dir/shots"

cmd_screenshot() {
    [ $# -ge 1 ] || usage
    local name="$1"
    shift
    local mode="${1:-}"
    local area=()
    case "$mode" in
        "") ;;
        --monitor)
            [ $# -eq 2 ] || usage
            read -r -a area < <(desk_monitor_rect "$2")
            ;;
        --window)
            [ $# -eq 2 ] || usage
            read -r -a area < <(desk_window_rect "$2")
            ;;
        --area)
            if [ $# -ne 2 ] || ! [[ "$2" =~ ^[0-9]+,[0-9]+,[0-9]+,[0-9]+$ ]]; then
                echo "testbed-pi: --area expects X,Y,WIDTH,HEIGHT" >&2
                exit 2
            fi
            IFS=, read -r -a area <<<"$2"
            ;;
        *) usage ;;
    esac
    if [ -n "$mode" ] && [ ${#area[@]} -ne 4 ]; then
        echo "testbed-pi: could not find the area for $*" >&2
        return 1
    fi
    mkdir -p "$shots_dir"
    local file="$shots_dir/$name.png"
    rm -f "$file"
    # `${area[@]+...}`: an empty array counts as unset under `set -u` in
    # bash before 4.4, such as the bash 3.2 macOS ships, where the tests
    # of this script can run.
    desk_screenshot "$file" ${area[@]+"${area[@]}"} || return 1
    echo "$file"
}

# =========================================================
# Input
# =========================================================

# ydotool writes to the kernel's uinput device, so its keys and clicks go
# to whatever the desktop has in focus: the visible terminal as much as
# the app. Every keyboard command therefore names its target first.

readonly input_timeout="${TORCHSNAP_TESTBED_INPUT_TIMEOUT:-3}"
readonly lock_timeout="${TORCHSNAP_TESTBED_LOCK_TIMEOUT:-10}"

# One input command at a time: a second one would read the first one's
# temporary `us` layout as the layout to go back to. The lock lives in
# the runtime directory, which a reboot empties, and names its owner, so
# a lock left by a killed process is taken over.
input_lock() {
    echo "${TORCHSNAP_TESTBED_RUNTIME_DIR:-$XDG_RUNTIME_DIR}/torchsnap-testbed/input.lock"
}

take_input_lock() {
    local lock owner
    lock="$(input_lock)"
    mkdir -p "$(dirname "$lock")"
    local deadline=$((SECONDS + lock_timeout))
    until mkdir "$lock" 2>/dev/null; do
        owner="$(cat "$lock/pid" 2>/dev/null || true)"
        if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
            rm -rf "$lock"
            continue
        fi
        if [ "$SECONDS" -ge "$deadline" ]; then
            echo "testbed-pi: input is in use by process ${owner:-?}" >&2
            return 1
        fi
        sleep "$poll_interval"
    done
    echo "$$" >"$lock/pid"
    input_locked=1
}

# parse_guard ARGS...: reads `--window REGEX` or `--shell-modal` into
# guard_mode and guard_regex; guard_shift is how many arguments it took.
parse_guard() {
    case "${1:-}" in
        --window)
            [ $# -ge 2 ] || usage
            guard_mode="window"
            guard_regex="$2"
            guard_shift=2
            ;;
        --shell-modal)
            guard_mode="modal"
            guard_shift=1
            ;;
        *)
            echo "testbed-pi: keyboard input needs --window REGEX or --shell-modal, so keys reach the intended target" >&2
            exit 2
            ;;
    esac
}

check_guard() {
    if [ "$guard_mode" = "modal" ]; then
        desk_shell_modal || { echo "testbed-pi: no Shell dialog or menu holds the keyboard" >&2; exit 4; }
        return
    fi
    local focused
    focused="$(desk_focused_window)" || exit 1
    python3 -c '
import json, re, sys
window = json.loads(sys.argv[1])
pattern = re.compile(sys.argv[2])
if window is None:
    sys.exit("testbed-pi: no window has focus, expected " + sys.argv[2])
if not (pattern.search(window["title"] or "") or pattern.search(window["wm_class"] or "")):
    sys.exit("testbed-pi: focused window is %s (%s), expected %s" % (window["title"], window["wm_class"], sys.argv[2]))
' "$focused" "$guard_regex" || exit 4
}

# The testbed types US key codes: ydotool maps characters to the keys of
# a US keyboard, while the machine's own layout may differ. So typing
# switches to the `us` layout and back afterwards; the trap switches back
# also when typing fails or the connection drops.
layout_to_restore=""
input_locked=""

finish_input() {
    if [ -n "$layout_to_restore" ]; then
        desk_activate_layout "$layout_to_restore" || true
        wait_for "$input_timeout" current_layout_is "$layout_to_restore" || true
        layout_to_restore=""
    fi
    if [ -n "$input_locked" ]; then
        rm -rf "$(input_lock)"
        input_locked=""
    fi
}

current_layout_is() {
    [ "$(desk_current_layout)" = "$1" ]
}

# begin_keys: lock, guard, `us` layout. end_keys: wait until the desktop
# has handled the keys, then everything back.
begin_keys() {
    trap finish_input EXIT
    trap 'finish_input; exit 130' INT TERM HUP
    take_input_lock || exit 1
    check_guard
    local layouts current us
    layouts="$(desk_layouts)" || exit 1
    current="$(python3 -c 'import json, sys; print(json.loads(sys.argv[1])["current"])' "$layouts")"
    us="$(python3 -c 'import json, sys; v = json.loads(sys.argv[1])["us"]; print("" if v is None else v)' "$layouts")"
    if [ -z "$us" ]; then
        echo "testbed-pi: the desktop has no 'us' keyboard layout; run just testbed-provision" >&2
        exit 1
    fi
    if [ "$current" != "$us" ]; then
        layout_to_restore="$current"
        desk_activate_layout "$us"
        wait_for "$input_timeout" current_layout_is "$us" \
            || { echo "testbed-pi: could not switch to the 'us' layout" >&2; exit 1; }
    fi
    park_pointer
}

# The barrier in end_keys moves the pointer. Over the launcher, a moving
# pointer can change the hovered or selected result, so the pointer waits
# in the bottom left corner, outside every window of the app.
park_pointer() {
    local y
    y="$(home_pointer)" || exit 1
    python3 -c '
import json, sys
x, y = 0, int(sys.argv[2])
for w in json.loads(sys.argv[1]) or []:
    r = w["rect"]
    if r["x"] <= x < r["x"] + r["width"] and r["y"] <= y < r["y"] + r["height"]:
        sys.exit("testbed-pi: an app window covers the bottom left corner, where the pointer waits while typing: " + json.dumps(w))
' "$(desk_app_windows)" "$y" || exit 1
}

# ydotool returns once its events are written to the uinput device; the
# desktop handles them later. Keys and pointer moves come from the same
# device, and the desktop handles that device's events in order, so after
# the keys the pointer, parked at the left edge, moves one pixel to the
# right and back: once the desktop reports the pointer moved, it has
# handled every key sent before. Switching the layout back any earlier
# could turn the last keys into those of the other layout.
pointer_x_is() {
    [ "$(desk_pointer | python3 -c 'import json, sys; print(json.load(sys.stdin)[0])')" = "$1" ]
}

end_keys() {
    ydotool mousemove -x 1 -y 0
    wait_for "$input_timeout" pointer_x_is 1 \
        || { echo "testbed-pi: the typed keys did not arrive within ${input_timeout}s" >&2; exit 1; }
    ydotool mousemove -x -1 -y 0
    wait_for "$input_timeout" pointer_x_is 0 || true
}

cmd_type() {
    parse_guard "$@"
    shift "$guard_shift"
    [ $# -eq 1 ] || usage
    begin_keys
    # From standard input, so ydotool reads no option or escape out of
    # the text.
    printf '%s' "$1" | ydotool type -f -
    end_keys
}

# key_code NAME: the evdev code of a key on a US keyboard.
key_code() {
    case "$1" in
        Escape) echo 1 ;; Return | Enter) echo 28 ;; Tab) echo 15 ;; BackSpace) echo 14 ;;
        space) echo 57 ;; Delete) echo 111 ;; Home) echo 102 ;; End) echo 107 ;;
        Up) echo 103 ;; Down) echo 108 ;; Left) echo 105 ;; Right) echo 106 ;;
        PageUp) echo 104 ;; PageDown) echo 109 ;;
        ctrl) echo 29 ;; shift) echo 42 ;; alt) echo 56 ;; super) echo 125 ;;
        q) echo 16 ;; w) echo 17 ;; e) echo 18 ;; r) echo 19 ;; t) echo 20 ;; y) echo 21 ;;
        u) echo 22 ;; i) echo 23 ;; o) echo 24 ;; p) echo 25 ;; a) echo 30 ;; s) echo 31 ;;
        d) echo 32 ;; f) echo 33 ;; g) echo 34 ;; h) echo 35 ;; j) echo 36 ;; k) echo 37 ;;
        l) echo 38 ;; z) echo 44 ;; x) echo 45 ;; c) echo 46 ;; v) echo 47 ;; b) echo 48 ;;
        n) echo 49 ;; m) echo 50 ;;
        1) echo 2 ;; 2) echo 3 ;; 3) echo 4 ;; 4) echo 5 ;; 5) echo 6 ;;
        6) echo 7 ;; 7) echo 8 ;; 8) echo 9 ;; 9) echo 10 ;; 0) echo 11 ;;
        *) return 1 ;;
    esac
}

# key_events COMBINATION: `ctrl+shift+t` presses ctrl, shift and t in
# order and releases them the other way round.
key_events() {
    local part code
    local codes=()
    local IFS=+
    for part in $1; do
        code="$(key_code "$part")" || { echo "testbed-pi: unknown key: $part" >&2; exit 2; }
        codes+=("$code")
    done
    local i
    for ((i = 0; i < ${#codes[@]}; i++)); do
        printf '%s:1 ' "${codes[$i]}"
    done
    for ((i = ${#codes[@]} - 1; i >= 0; i--)); do
        printf '%s:0 ' "${codes[$i]}"
    done
}

cmd_key() {
    parse_guard "$@"
    shift "$guard_shift"
    [ $# -ge 1 ] || usage
    local events="" name
    for name in "$@"; do
        events="$events$(key_events "$name")"
    done
    begin_keys
    # shellcheck disable=SC2086 # one word per key event
    ydotool key $events
    end_keys
}

# ydotool's absolute move leaves the X position at 0 (v1.0.4), so the
# pointer is moved far to the bottom left first, where the screen edges
# stop it, and from there by the distance to the target. With flat pointer
# acceleration (provisioned) a relative move covers exactly that many
# logical pixels. The bottom left, not the top left: GNOME opens the
# overview when the pointer hits the top left corner.
pointer_at() {
    desk_pointer | python3 -c 'import json, sys; sys.exit(0 if json.load(sys.stdin) == [int(sys.argv[1]), int(sys.argv[2])] else 1)' "$1" "$2"
}

pointer_y() {
    desk_pointer | python3 -c 'import json, sys; print(json.load(sys.stdin)[1])'
}

# home_pointer: moves the pointer to the bottom left corner and prints its
# Y position there.
home_pointer() {
    ydotool mousemove -x -100000 -y 100000
    wait_for "$input_timeout" pointer_x_is 0 \
        || { echo "testbed-pi: the pointer did not reach the left edge" >&2; return 1; }
    pointer_y
}

# A move with both an X and a Y part right after the homing move lost its
# X part on GNOME 48, so each axis moves on its own.
move_pointer() {
    local home_y
    home_y="$(home_pointer)" || return 1
    ydotool mousemove -x "$1" -y 0
    wait_for "$input_timeout" pointer_x_is "$1" || true
    ydotool mousemove -x 0 -y "$(($2 - home_y))"
    if ! wait_for "$input_timeout" pointer_at "$1" "$2"; then
        echo "testbed-pi: pointer at $(desk_pointer | python3 -c 'import json, sys; print(json.dumps(json.load(sys.stdin)))'), expected [$1, $2]" >&2
        return 1
    fi
}

cmd_pointer() {
    [ $# -eq 2 ] || usage
    trap finish_input EXIT
    take_input_lock || exit 1
    move_pointer "$1" "$2" || exit 1
}

cmd_click() {
    [ $# -ge 2 ] && [ $# -le 3 ] || usage
    local button
    case "${3:-left}" in
        left) button=0xC0 ;;
        right) button=0xC1 ;;
        middle) button=0xC2 ;;
        *) usage ;;
    esac
    trap finish_input EXIT
    take_input_lock || exit 1
    move_pointer "$1" "$2" || exit 1
    ydotool click "$button"
}

# =========================================================
# Headless sessions
# =========================================================

readonly headless_unit="torchsnap-testbed-headless"
readonly headless_app_unit="torchsnap-testbed-app-headless"
readonly headless_dir="$state_dir/headless"
readonly headless_bus_file="$headless_dir/bus"
readonly headless_display="torchsnap-headless"
readonly headless_timeout="${TORCHSNAP_TESTBED_HEADLESS_TIMEOUT:-60}"
headless=""

# --headless points the rest of this run at the headless session: its
# Wayland display and D-Bus bus, and the headless app's own data
# directories (so it has its own control socket and settings).
use_headless_session() {
    if ! systemctl --user is-active --quiet "$headless_unit"; then
        echo "testbed-pi: no headless session; start one with just testbed-headless-start" >&2
        exit 1
    fi
    headless=1
    unset DISPLAY XAUTHORITY
    export WAYLAND_DISPLAY="$headless_display"
    DBUS_SESSION_BUS_ADDRESS="$(cat "$headless_bus_file")"
    export DBUS_SESSION_BUS_ADDRESS
    export XDG_DATA_HOME="$headless_dir/app/data"
    export XDG_CONFIG_HOME="$headless_dir/app/config"
    export XDG_CACHE_HOME="$headless_dir/app/cache"
    app_unit="$headless_app_unit"
    app_log="$state_dir/app-headless.log"
}

# Monitor specs are WIDTHxHEIGHT@SCALE, one per virtual monitor, placed
# side by side.
cmd_headless_start() {
    local specs=("$@")
    [ ${#specs[@]} -gt 0 ] || specs=(1280x800@1 2560x1600@2)
    local spec
    for spec in "${specs[@]}"; do
        if ! [[ "$spec" =~ ^[0-9]+x[0-9]+@[0-9]+(\.[0-9]+)?$ ]]; then
            echo "testbed-pi: monitor spec '$spec' is not WIDTHxHEIGHT@SCALE" >&2
            exit 2
        fi
    done
    if systemctl --user is-active --quiet "$headless_unit"; then
        echo "testbed-pi: a headless session is already running ($headless_unit)" >&2
        return 1
    fi
    rm -f "$headless_bus_file"
    mkdir -p "$headless_dir"
    desk_headless_start "${specs[@]}" || return 1
}

cmd_headless_stop() {
    local unit
    for unit in "$headless_app_unit" "$headless_unit"; do
        if systemctl --user is-active --quiet "$unit"; then
            systemctl --user stop "$unit"
        fi
    done
    rm -f "$headless_bus_file"
}

# =========================================================
# Tray
# =========================================================

cmd_tray() {
    case "${1:-}" in
        on | off) desk_tray_switch "$1" ;;
        status)
            if tray_state_is ACTIVE; then echo on; else echo off; fi
            ;;
        *) usage ;;
    esac
}

cmd_tray_click() {
    local icon center
    icon="$(desk_tray_icon)" || exit 1
    center="$(python3 -c '
import json, sys
i = json.loads(sys.argv[1])
print(i["x"] + i["width"] // 2, i["y"] + i["height"] // 2)
' "$icon")"
    # shellcheck disable=SC2086 # "X Y"
    cmd_click $center "${1:-left}"
}

# =========================================================
# Recording
# =========================================================

readonly record_unit="torchsnap-testbed-record"
readonly record_log="$state_dir/record.log"
readonly recordings_dir="$state_dir/recordings"
readonly record_timeout="${TORCHSNAP_TESTBED_RECORD_TIMEOUT:-10}"

recording() {
    systemctl --user is-active --quiet "$record_unit"
}

# The path of the current recording, from gnome-record's `started` line.
recorded_file() {
    sed -n 's/^started //p' "$record_log" 2>/dev/null | tail -n 1
}

cmd_record_start() {
    [ $# -eq 1 ] || usage
    if recording; then
        echo "testbed-pi: already recording ($record_unit)" >&2
        return 1
    fi
    mkdir -p "$recordings_dir"
    : >"$record_log"
    systemd-run --user --unit "$record_unit" --collect --quiet \
        -p "StandardOutput=append:$record_log" -p "StandardError=append:$record_log" \
        python3 "$pi_dir/gnome-record" "$recordings_dir/$1"
    local deadline=$((SECONDS + record_timeout))
    until [ -n "$(recorded_file)" ]; do
        if [ "$SECONDS" -ge "$deadline" ]; then
            echo "testbed-pi: the recording did not start within ${record_timeout}s:" >&2
            cat "$record_log" >&2
            return 1
        fi
        sleep "$poll_interval"
    done
    recorded_file
}

# The recording file is complete once ffprobe can read its duration.
has_duration() {
    ffprobe -v error -show_entries format=duration -of csv=p=0 "$1" | grep -q '^[0-9]'
}

cmd_record_stop() {
    if ! recording; then
        echo "testbed-pi: no recording is running" >&2
        return 1
    fi
    local file
    file="$(recorded_file)"
    systemctl --user stop "$record_unit"
    wait_for 30 has_duration "$file" \
        || { echo "testbed-pi: the recording $file is not readable" >&2; return 1; }
    echo "$file"
}

# =========================================================
# Everything back
# =========================================================

# The self-test records the desktop's state before its first item here
# (`tray=on|off`, `monitors=<checksum of ~/.config/monitors.xml>`).
readonly selftest_initial="$state_dir/selftest-initial"

# Stops every testbed unit, the recording first so its file is complete,
# and the app before the headless session it may run in; with a recorded
# initial state, the tray support goes back to it.
cmd_stop_all() {
    local unit
    for unit in "$record_unit" "$headless_app_unit" "$headless_unit" torchsnap-testbed-app; do
        if systemctl --user is-active --quiet "$unit"; then
            systemctl --user stop "$unit"
        fi
    done
    # tools/bench-memory runs the app in a scope `torchsnap-bench-<time>`,
    # which outlives a bench that was killed hard. The pattern matches
    # loaded units only; with none, the stop does nothing and succeeds.
    systemctl --user stop 'torchsnap-bench-*.scope'
    rm -f "$headless_bus_file"
    if [ -f "$selftest_initial" ]; then
        local tray
        tray="$(sed -n 's/^tray=//p' "$selftest_initial")"
        case "$tray" in
            on | off) desk_tray_switch "$tray" ;;
        esac
    fi
}

# =========================================================
# Memory benchmark
# =========================================================

# tools/bench-memory runs the scenario against the current build and
# starts the app itself, as a child that inherits this environment: the
# desktop session's variables, or with --headless the headless
# session's (with GDK_BACKEND=wayland and no X11 display, as app-start
# gives the headless app). The compositor's PID lets the bench record
# GNOME Shell's memory apart from the app's. Its data files and log stay
# in the testbed's state directory, outside the synced tree.
readonly bench_dir="$state_dir/bench-memory"

cmd_bench_memory() {
    local app_binary compositor
    app_binary="$(current_app_binary)" || return 1
    compositor="$(desk_compositor_pid)" || return 1
    cmd_merge_app_settings
    if [ -n "$headless" ]; then
        export GDK_BACKEND=wayland
    fi
    mkdir -p "$bench_dir"
    exec "$tree_dir/tools/bench-memory" "$@" --app "$app_binary" \
        --output-dir "$bench_dir" --log "$bench_dir/memory-benchmark.log" \
        --compositor-pid "$compositor"
}

# =========================================================
# Clipboard
# =========================================================

readonly clipboard_timeout="${TORCHSNAP_TESTBED_CLIPBOARD_TIMEOUT:-5}"

# wl-copy forks a process that serves the clipboard until something else
# is copied, and that process keeps wl-copy's standard output and error.
# A caller reading them (ssh, a pipe) would wait for that process to end,
# so they go to /dev/null; and wl-copy's own exit is waited for with a
# time limit.
cmd_clipboard_set() {
    [ $# -eq 1 ] || usage
    printf '%s' "$1" | wl-copy >/dev/null 2>&1 &
    local copier=$!
    local deadline=$((SECONDS + clipboard_timeout))
    while kill -0 "$copier" 2>/dev/null; do
        if [ "$SECONDS" -ge "$deadline" ]; then
            kill "$copier" 2>/dev/null || true
            echo "testbed-pi: wl-copy did not return within ${clipboard_timeout}s" >&2
            return 1
        fi
        sleep 0.1
    done
    wait "$copier"
}

cmd_clipboard_get() {
    wl-paste --no-newline
}

# =========================================================
# Dispatch
# =========================================================

[ $# -gt 0 ] || usage
subcommand="$1"
shift

session_env

# `--headless`, anywhere among the arguments of the subcommands that can
# work in the headless session, switches them to it.
case "$subcommand" in
    app-start | app-stop | app-log | control | eval | windows | launcher-state | screenshot | merge-app-settings | bench-memory)
        arguments=()
        for argument in "$@"; do
            if [ "$argument" = "--headless" ]; then
                use_headless_session
            else
                arguments+=("$argument")
            fi
        done
        set -- ${arguments[@]+"${arguments[@]}"}
        ;;
esac

case "$subcommand" in
    headless-start)
        load_desktop
        cmd_headless_start "$@"
        ;;
    headless-stop) cmd_headless_stop ;;
    stop-all)
        load_desktop
        cmd_stop_all
        ;;
    bench-memory)
        load_desktop
        cmd_bench_memory "$@"
        ;;
    env)
        print_session_env
        ;;
    session-ready)
        load_desktop
        desk_session_ready
        ;;
    build) cmd_build ;;
    deploy-start) cmd_deploy_start ;;
    deploy-finish) cmd_deploy_finish ;;
    app-start) cmd_app_start ;;
    app-stop) cmd_app_stop ;;
    app-log) cmd_app_log "$@" ;;
    control) cmd_control "$@" ;;
    merge-app-settings) cmd_merge_app_settings ;;
    eval)
        [ $# -eq 1 ] || usage
        load_desktop
        desk_eval "$1"
        ;;
    windows)
        load_desktop
        desk_app_windows
        ;;
    launcher-state)
        load_desktop
        cmd_launcher_state
        ;;
    screenshot)
        load_desktop
        cmd_screenshot "$@"
        ;;
    type)
        load_desktop
        cmd_type "$@"
        ;;
    key)
        load_desktop
        cmd_key "$@"
        ;;
    pointer)
        load_desktop
        cmd_pointer "$@"
        ;;
    click)
        load_desktop
        cmd_click "$@"
        ;;
    tray)
        load_desktop
        cmd_tray "$@"
        ;;
    tray-icon)
        load_desktop
        desk_tray_icon
        ;;
    tray-click)
        load_desktop
        cmd_tray_click "$@"
        ;;
    record-start) cmd_record_start "$@" ;;
    record-stop) cmd_record_stop ;;
    clipboard-set) cmd_clipboard_set "$@" ;;
    clipboard-get) cmd_clipboard_get ;;
    *)
        usage
        ;;
esac
