# The program `testbed-pi bench-memory` hands to tools/bench-memory as
# --screen-check: testbed-pi's screen-check, in the session the bench
# runs in. testbed-pi exports TORCHSNAP_TESTBED_HEADLESS for a bench in
# the headless session, whose Shell the check has to ask.

set -euo pipefail

pi_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -n "${TORCHSNAP_TESTBED_HEADLESS:-}" ]; then
    exec "$pi_dir/testbed-pi" screen-check "$@" --headless
fi
exec "$pi_dir/testbed-pi" screen-check "$@"
