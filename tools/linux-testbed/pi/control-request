# Sends one JSON-RPC request to Torchsnap's control socket and prints the
# one-line response (docs/control-api.md).
#
# Usage: control-request SOCKET METHOD [PARAMS_JSON]
#
# The server keeps a connection open for further requests, so a client
# that waits for the server to close it (as socat does) would wait for its
# own timeout. This one reads exactly one response line and closes.
# Exits 0 with a `result`, 1 with an `error` member, 2 when the socket
# does not answer.

import json
import socket
import sys


def main():
    if len(sys.argv) not in (3, 4):
        print("usage: control-request SOCKET METHOD [PARAMS_JSON]", file=sys.stderr)
        return 2
    path, method = sys.argv[1], sys.argv[2]
    request = {"jsonrpc": "2.0", "id": 1, "method": method}
    if len(sys.argv) == 4:
        request["params"] = json.loads(sys.argv[3])

    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.settimeout(10)
            connection.connect(path)
            connection.sendall((json.dumps(request) + "\n").encode())
            response = b""
            while not response.endswith(b"\n"):
                chunk = connection.recv(65536)
                if not chunk:
                    break
                response += chunk
    except OSError as error:
        print(f"control-request: {path}: {error}", file=sys.stderr)
        return 2

    line = response.decode().strip()
    print(line)
    return 1 if "error" in json.loads(line) else 0


if __name__ == "__main__":
    sys.exit(main())
