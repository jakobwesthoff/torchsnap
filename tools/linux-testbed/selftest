# Self-test of the Linux testbed: runs the testbed's acceptance items
# against the machine named by TORCHSNAP_LINUX_HOST and checks their
# results. Each item prints `PASS item N` or `FAIL item N: <what>`; the
# run goes on after a failure and exits 1 if any item failed.
#
# Usage:
#   selftest [ITEM...]   run the given items, or the default list
#
# Items:
#   1   provisioning twice changes nothing on the second run
#   2   sync and build: a debug binary newer than the build's start
#       (only when named)
#   W   the launcher, shown through the control socket, is among the
#       app's windows, with a size and keyboard focus
#   R   after a reboot the machine is back in its desktop session with
#       everything the testbed needs (only when named)
#   U   undoing one provision step at a time, provisioning reports
#       `changed` for exactly that step (only when named)
#   P   the installing steps install again when what they installed is
#       gone (only when named; downloads and builds, about 10 minutes)

# Items run by name (`item_$item`), which shellcheck cannot follow, and
# command lines for the machine are single-quoted so they expand there.
# shellcheck disable=SC2329,SC2016
set -uo pipefail

testbed="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/testbed"
readonly testbed

default_items=(1 W)

pass() {
    echo "PASS item $1"
}

# fail ITEM WHAT: reports a failed assertion and makes the item fail.
fail() {
    echo "FAIL item $1: $2"
    return 1
}

# on_machine COMMAND: runs a shell command line on the machine.
on_machine() {
    "$testbed" exec "$1"
}

# The provision steps' own check for the keyring: an Unlock that needs no
# prompt answers with the prompt path "/".
readonly keyring_unlock='busctl --user call org.freedesktop.secrets /org/freedesktop/secrets org.freedesktop.Secret.Service Unlock ao 1 /org/freedesktop/secrets/collection/testbed'
readonly keyring_unlocked='aoo 1 "/org/freedesktop/secrets/collection/testbed" "/"'

# Whether a notification about unsafe mode is in GNOME Shell's message tray.
readonly unsafe_mode_notification='gdbus call --session --dest org.gnome.Shell --object-path /org/gnome/Shell --method org.gnome.Shell.Eval "Main.messageTray.getSources().some(s => s.notifications.some(n => n.title.includes(\"unsafe mode\")))"'

# =========================================================
# Items
# =========================================================

# The machine is provisioned already when the self-test runs, so a run
# that is not the first must leave everything as it found it.
item_1() {
    local output status
    if ! "$testbed" provision >/dev/null; then
        fail 1 "first provision run did not exit 0"
        return
    fi
    output="$("$testbed" provision)"
    status=$?
    if [ "$status" -ne 0 ]; then
        fail 1 "second provision run: expected exit 0, got $status"
    elif ! grep -q '^provision: 0 changed' <<<"$output"; then
        fail 1 "second provision run: expected '0 changed', got: $(grep '^provision:' <<<"$output")"
    else
        pass 1
    fi
}

# app_up ITEM: starts the app unless it runs; reports a setup failure.
app_up() {
    if on_machine 'systemctl --user is-active --quiet torchsnap-testbed-app'; then
        return 0
    fi
    "$testbed" app-start >/dev/null || { fail "$1" "SETUP: app-start failed"; return 1; }
}

# The launcher, shown through the control socket, is among the app's
# windows with its WM class, a size and keyboard focus.
item_W() {
    local windows problem
    app_up W || return
    "$testbed" control show >/dev/null || { fail W "SETUP: control show failed"; return; }
    windows="$("$testbed" windows)" || { fail W "windows failed"; return; }
    problem="$(python3 -c '
import json, sys
launcher = next((w for w in json.loads(sys.argv[1]) if w["title"] == ""), None)
if launcher is None:
    print("no launcher window in: " + sys.argv[1])
elif launcher["wm_class"] != "torchsnap" or launcher["rect"]["width"] <= 0 or launcher["rect"]["height"] <= 0:
    print("unexpected launcher window: " + json.dumps(launcher))
elif not launcher["focused"]:
    print("the launcher does not have keyboard focus")
' "$windows")"
    "$testbed" control dismiss >/dev/null
    if [ -n "$problem" ]; then
        fail W "$problem"
        return
    fi
    pass W
}

# A build after a sync has to leave a debug binary written by this build.
item_2() {
    local started built
    if ! started="$(on_machine 'date +%s')"; then
        fail 2 "SETUP: could not read the machine's clock"
        return
    fi
    if ! "$testbed" build; then
        fail 2 "the build failed (see above)"
        return
    fi
    built="$(on_machine 'stat -c %Y "$HOME/torchsnap/src-tauri/target/debug/torchsnap"')" \
        || { fail 2 "no debug binary after the build"; return; }
    [ "$built" -ge "$started" ] \
        || { fail 2 "the debug binary is older than the build ($built < $started)"; return; }
    pass 2
}

# Nobody is at the machine after a reboot, so everything the recipes need
# has to come back on its own.
item_R() {
    local before after env status output
    if ! before="$(on_machine 'cat /proc/sys/kernel/random/boot_id')"; then
        fail R "SETUP: could not read the boot id"
        return
    fi
    if ! "$testbed" reboot; then
        fail R "the reboot did not finish (see above)"
        return
    fi
    after="$(on_machine 'cat /proc/sys/kernel/random/boot_id')"
    [ "$after" != "$before" ] || { fail R "boot id unchanged: $after"; return; }

    env="$(on_machine '"$HOME"/torchsnap/tools/linux-testbed/pi/testbed-pi env')"
    grep -qx 'XDG_CURRENT_DESKTOP=GNOME' <<<"$env" \
        || { fail R "session is not GNOME: $(grep XDG_CURRENT_DESKTOP <<<"$env")"; return; }
    on_machine 'systemctl --user is-active --quiet ydotool.service' \
        || { fail R "ydotool.service is not active"; return; }
    on_machine 'test "$(stat -c %G:%a /dev/uinput)" = input:660' \
        || { fail R "/dev/uinput is not group input, mode 660"; return; }
    on_machine 'systemctl --user is-active --quiet gnome-remote-desktop.service && ss -ltn | grep -q ":3389 "' \
        || { fail R "gnome-remote-desktop is not listening on 3389"; return; }
    [ "$(on_machine "$keyring_unlock")" = "$keyring_unlocked" ] \
        || { fail R "the testbed keyring does not unlock without a prompt"; return; }
    # GNOME Shell announces unsafe mode with a banner over the top of the
    # screen, which would show in screenshots; the extension removes it.
    [ "$(on_machine "$unsafe_mode_notification")" = "(true, 'false')" ] \
        || { fail R "GNOME Shell shows the unsafe-mode notification"; return; }

    output="$("$testbed" provision)"
    status=$?
    if [ "$status" -ne 0 ] || ! grep -q '^provision: 0 changed' <<<"$output"; then
        fail R "provision after the reboot: exit $status, $(grep '^provision:' <<<"$output")"
        return
    fi
    pass R
}

# Each entry: a provision step and a command that undoes it. These are the
# steps that can be undone without reinstalling packages or toolchains
# and without taking the desktop away.
undo_steps=(
    'testbed-extension|sudo rm -rf /usr/local/share/gnome-shell/extensions/unsafe-mode@testbed.torchsnap.app'
    'dconf-defaults|sudo rm /etc/dconf/db/local.d/50-torchsnap-testbed && sudo dconf update'
    'gdm|echo /usr/sbin/lightdm | sudo tee /etc/X11/default-display-manager >/dev/null'
    'accountsservice-session|sudo sed -i "s/^Session=gnome$/Session=/" "/var/lib/AccountsService/users/$USER"'
    'uinput|sudo rm /etc/modules-load.d/torchsnap-testbed-uinput.conf && sudo chmod 600 /dev/uinput'
    'ydotool-service|systemctl --user disable --now ydotool.service'
    'sleep-masked|sudo systemctl unmask hybrid-sleep.target'
    'user-settings|gsettings reset org.gnome.desktop.input-sources sources'
    'keyring|busctl --user call org.freedesktop.secrets /org/freedesktop/secrets org.freedesktop.Secret.Service SetAlias so default /org/freedesktop/secrets/collection/login'
    'rdp|grdctl rdp disable'
)

item_U() {
    local entry step undo output status changed
    output="$("$testbed" provision)"
    if ! grep -q '^provision: 0 changed' <<<"$output"; then
        fail U "SETUP: the machine is not fully provisioned: $(grep '^provision:' <<<"$output")"
        return
    fi
    for entry in "${undo_steps[@]}"; do
        step="${entry%%|*}"
        undo="${entry#*|}"
        if ! on_machine "$undo" >/dev/null; then
            fail U "SETUP: could not undo $step"
            return
        fi
        output="$("$testbed" provision)"
        status=$?
        changed="$(grep '^changed ' <<<"$output" | tr '\n' ' ')"
        if [ "$status" -ne 0 ] || [ "$changed" != "changed $step " ]; then
            fail U "after undoing $step: exit $status, ${changed:-nothing changed}"
            return
        fi
        echo "  undone and restored: $step"
    done
    pass U
}

# Install paths: each entry removes or moves aside what one installing
# step checks for, so provisioning runs that step's install again; the
# moved-aside original is deleted afterwards, or put back when the run
# failed. The fields: step, how to remove it, what to do afterwards on
# success, what to do on failure.
install_steps=(
    'base-packages|sudo apt-get remove -y scdoc|true|sudo apt-get install -y scdoc'
    'rustup|mv ~/.cargo/bin/rustup ~/.cargo/bin/rustup.aside|rm -f ~/.cargo/bin/rustup.aside|mv ~/.cargo/bin/rustup.aside ~/.cargo/bin/rustup'
    'bun|mv ~/.bun ~/.bun.aside|rm -rf ~/.bun.aside|rm -rf ~/.bun && mv ~/.bun.aside ~/.bun'
    'just|mv ~/.local/bin/just ~/.local/bin/just.aside|rm -f ~/.local/bin/just.aside|mv ~/.local/bin/just.aside ~/.local/bin/just'
    'wasm-tools|mv ~/.cargo/bin/wasm-tools ~/.cargo/bin/wasm-tools.aside|rm -f ~/.cargo/bin/wasm-tools.aside|mv ~/.cargo/bin/wasm-tools.aside ~/.cargo/bin/wasm-tools'
)

# Removing any of GNOME's packages would take gnome-shell and gdm with
# it, so the GNOME package step's install runs on the installed system
# and must leave the package list and the display manager choice as they
# were.
readonly gnome_packages_state='dpkg-query -W -f="\${Package} \${Version} \${Status}\n" | md5sum; sudo debconf-show gdm3 lightdm | grep default-x-display-manager'
readonly gnome_packages_apply='cd ~/torchsnap/tools/linux-testbed/provision && bash -c "set -euo pipefail; provision_dir=\$PWD; tree_dir=\$(cd ../../.. && pwd); monitor_spec=; source steps.sh; source base.sh; source desktop-gnome.sh; apply_gnome_packages"'

item_P() {
    local entry step undo cleanup restore output status changed before after
    output="$("$testbed" provision)"
    if ! grep -q '^provision: 0 changed' <<<"$output"; then
        fail P "SETUP: the machine is not fully provisioned: $(grep '^provision:' <<<"$output")"
        return
    fi
    for entry in "${install_steps[@]}"; do
        IFS='|' read -r step undo cleanup restore <<<"$entry"
        if ! on_machine "$undo" >/dev/null; then
            fail P "SETUP: could not remove $step"
            return
        fi
        output="$("$testbed" provision)"
        status=$?
        changed="$(grep '^changed ' <<<"$output" | tr '\n' ' ')"
        if [ "$status" -ne 0 ] || [ "$changed" != "changed $step " ]; then
            on_machine "$restore" >/dev/null
            fail P "after removing $step: exit $status, ${changed:-nothing changed}"
            return
        fi
        on_machine "$cleanup" >/dev/null
        echo "  installed again: $step"
    done

    before="$(on_machine "$gnome_packages_state")"
    on_machine "$gnome_packages_apply" >/dev/null || { fail P "the GNOME package install failed"; return; }
    after="$(on_machine "$gnome_packages_state")"
    [ "$before" = "$after" ] || { fail P "the GNOME package install changed packages or the display manager choice"; return; }
    echo "  installed again on the installed system: gnome-packages"
    pass P
}

# =========================================================
# Runner
# =========================================================

items=("$@")
if [ ${#items[@]} -eq 0 ]; then
    items=("${default_items[@]}")
fi

# Every item is checked before the first runs, so a typo does not cost a
# partial run on the machine.
for item in "${items[@]}"; do
    if ! declare -F "item_$item" >/dev/null; then
        echo "selftest: unknown item: $item" >&2
        exit 2
    fi
done

failed=0
for item in "${items[@]}"; do
    "item_$item" || failed=1
done
exit "$failed"
