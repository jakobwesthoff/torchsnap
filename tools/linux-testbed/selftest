# Self-test of the Linux testbed: runs the testbed's acceptance items
# against the machine named by TORCHSNAP_LINUX_HOST and checks their
# results. Each item prints `PASS item N` or `FAIL item N: <what>`; the
# run goes on after a failure and exits 1 if any item failed.
#
# Usage:
#   selftest [ITEM...]   run the given items, or the default list
#
# Items:
#   1   provisioning twice changes nothing on the second run
#   2   sync and build: a debug binary newer than the build's start
#       (only when named)
#   W   the launcher, shown through the control socket, is among the
#       app's windows, with a size and keyboard focus
#   4   the launcher opens through the control socket with focus, shows
#       a typed query, and closes with Escape
#   L   typing produces exactly the characters asked for (`us` layout),
#       and the machine's layout is back afterwards
#   E   machine-side commands answer the same with the runner's
#       environment cleared
#   6   text set on the clipboard through the recipe comes back unchanged
#   3   needs the tray on, then off: the app's tray icon is in the top bar
#       only with GNOME's AppIndicator extension
#   5   needs the tray on: clicking the tray icon opens its menu, Escape
#       closes it
#   9   a screen recording shows the launcher opening
#   R   after a reboot the machine is back in its desktop session with
#       everything the testbed needs (only when named)
#   U   undoing one provision step at a time, provisioning reports
#       `changed` for exactly that step (only when named)
#   P   the installing steps install again when what they installed is
#       gone (only when named; downloads and builds, about 10 minutes)

# Items run by name (`item_$item`), which shellcheck cannot follow, and
# command lines for the machine are single-quoted so they expand there.
# shellcheck disable=SC2329,SC2016
set -uo pipefail

testbed="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/testbed"
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
readonly testbed repo_root

default_items=(1 W 4 L E 6 3 5 9)

pass() {
    echo "PASS item $1"
}

# fail ITEM WHAT: reports a failed assertion and makes the item fail.
fail() {
    echo "FAIL item $1: $2"
    return 1
}

# on_machine COMMAND: runs a shell command line on the machine.
on_machine() {
    "$testbed" exec "$1"
}

# The provision steps' own check for the keyring: an Unlock that needs no
# prompt answers with the prompt path "/".
readonly keyring_unlock='busctl --user call org.freedesktop.secrets /org/freedesktop/secrets org.freedesktop.Secret.Service Unlock ao 1 /org/freedesktop/secrets/collection/testbed'
readonly keyring_unlocked='aoo 1 "/org/freedesktop/secrets/collection/testbed" "/"'

# Whether a notification about unsafe mode is in GNOME Shell's message tray.
readonly unsafe_mode_notification='gdbus call --session --dest org.gnome.Shell --object-path /org/gnome/Shell --method org.gnome.Shell.Eval "Main.messageTray.getSources().some(s => s.notifications.some(n => n.title.includes(\"unsafe mode\")))"'

# =========================================================
# Items
# =========================================================

# The machine is provisioned already when the self-test runs, so a run
# that is not the first must leave everything as it found it.
item_1() {
    local output status
    if ! "$testbed" provision >/dev/null; then
        fail 1 "first provision run did not exit 0"
        return
    fi
    output="$("$testbed" provision)"
    status=$?
    if [ "$status" -ne 0 ]; then
        fail 1 "second provision run: expected exit 0, got $status"
    elif ! grep -q '^provision: 0 changed' <<<"$output"; then
        fail 1 "second provision run: expected '0 changed', got: $(grep '^provision:' <<<"$output")"
    else
        pass 1
    fi
}

# app_up ITEM: starts the app unless it runs; reports a setup failure.
app_up() {
    if on_machine 'systemctl --user is-active --quiet torchsnap-testbed-app'; then
        return 0
    fi
    "$testbed" app-start >/dev/null || { fail "$1" "SETUP: app-start failed"; return 1; }
}

# The launcher, shown through the control socket, is among the app's
# windows with its WM class, a size and keyboard focus.
item_W() {
    local windows problem
    app_up W || return
    "$testbed" control show >/dev/null || { fail W "SETUP: control show failed"; return; }
    windows="$("$testbed" windows)" || { fail W "windows failed"; return; }
    problem="$(python3 -c '
import json, sys
launcher = next((w for w in json.loads(sys.argv[1]) if w["title"] == ""), None)
if launcher is None:
    print("no launcher window in: " + sys.argv[1])
elif launcher["wm_class"] != "torchsnap" or launcher["rect"]["width"] <= 0 or launcher["rect"]["height"] <= 0:
    print("unexpected launcher window: " + json.dumps(launcher))
elif not launcher["focused"]:
    print("the launcher does not have keyboard focus")
' "$windows")"
    "$testbed" control dismiss >/dev/null
    if [ -n "$problem" ]; then
        fail W "$problem"
        return
    fi
    pass W
}

# wait_until TIMEOUT COMMAND...: polls COMMAND every half second.
wait_until() {
    local deadline=$((SECONDS + $1))
    shift
    until "$@" >/dev/null 2>&1; do
        [ "$SECONDS" -lt "$deadline" ] || return 1
        sleep 0.5
    done
}

launcher_is() {
    local state
    state="$("$testbed" launcher-state)" || return 1
    python3 -c '
import json, sys
state = json.loads(sys.argv[1])
want = sys.argv[2]
ok = {"shown": state["visible"] and state["focused"], "hidden": not state["visible"]}[want]
sys.exit(0 if ok else 1)
' "$state" "$1"
}

# differ A B: whether two pictures differ in more than a few pixels
# (ImageMagick's absolute error count).
differ() {
    local count
    count="$(magick compare -metric AE "$1" "$2" null: 2>&1 | awk '{print $1}')"
    [ "${count%.*}" -gt 100 ] 2>/dev/null
}

shot() {
    "$testbed" screenshot "$@" | tail -n 1
}

# The launcher, opened through the control socket, takes focus, shows
# what is typed into it, and closes with Escape: the first Escape clears
# the query, the second hides the launcher
# (src/launcher/hooks/useKeyboardNavigation.ts).
readonly launcher_query="enough"

item_4() {
    local rect hidden shown typed cleared
    app_up 4 || return
    "$testbed" control show >/dev/null || { fail 4 "SETUP: control show failed"; return; }
    wait_until 10 launcher_is shown || { fail 4 "the launcher is not shown with focus after control show"; return; }
    rect="$("$testbed" windows | python3 -c '
import json, sys
w = next(w for w in json.load(sys.stdin) if w["title"] == "")
r = w["rect"]
print("%d,%d,%d,%d" % (r["x"], r["y"], r["width"], r["height"]))
')" || { fail 4 "no launcher window"; return; }

    # The same area with the launcher hidden is the baseline.
    "$testbed" control dismiss >/dev/null
    wait_until 10 launcher_is hidden || { fail 4 "the launcher did not hide after dismiss"; return; }
    hidden="$(shot item4-hidden --area "$rect")"
    "$testbed" control show >/dev/null
    wait_until 10 launcher_is shown || { fail 4 "the launcher is not shown with focus after control show"; return; }
    shown="$(shot item4-shown --area "$rect")"
    differ "$hidden" "$shown" || { fail 4 "the launcher area looks the same shown and hidden"; return; }

    "$testbed" type --window '^torchsnap$' "$launcher_query" || { fail 4 "typing into the launcher failed"; return; }
    typed_differs() { typed="$(shot item4-typed --area "$rect")" && differ "$shown" "$typed"; }
    wait_until 10 typed_differs || { fail 4 "the launcher looks the same after typing '$launcher_query'"; return; }
    typed="$(shot item4-typed --area "$rect")"

    "$testbed" key --window '^torchsnap$' Escape || { fail 4 "the first Escape failed"; return; }
    cleared_differs() { cleared="$(shot item4-cleared --area "$rect")" && differ "$typed" "$cleared"; }
    wait_until 10 cleared_differs || { fail 4 "the first Escape did not clear the query"; return; }
    launcher_is shown || { fail 4 "the first Escape closed the launcher instead of clearing the query"; return; }

    "$testbed" key --window '^torchsnap$' Escape || { fail 4 "the second Escape failed"; return; }
    wait_until 10 launcher_is hidden || { fail 4 "the launcher is still visible after the second Escape"; return; }
    pass 4
}

# GNOME Shell's run dialog is a Shell entry whose text Eval can read, so
# it shows exactly which characters the testbed's typing produces,
# independent of the app. Typing switches to the `us` layout and back.
item_L() {
    local layout_before layout_after text
    layout_before="$("$testbed" eval 'Main.panel.statusArea.keyboard._inputSourceManager.currentSource.id')" \
        || { fail L "SETUP: could not read the keyboard layout"; return; }
    "$testbed" eval 'Main.openRunDialog()' >/dev/null || { fail L "SETUP: could not open the run dialog"; return; }
    modal_open() { [ "$("$testbed" eval 'Main.modalCount > 0')" = "true" ]; }
    wait_until 10 modal_open || { fail L "SETUP: the run dialog did not open"; return; }
    if ! "$testbed" type --shell-modal 'yz-@[]'; then
        "$testbed" key --shell-modal Escape >/dev/null
        fail L "typing into the run dialog failed"
        return
    fi
    text="$("$testbed" eval 'global.stage.get_key_focus().get_text()')"
    "$testbed" key --shell-modal Escape >/dev/null
    layout_after="$("$testbed" eval 'Main.panel.statusArea.keyboard._inputSourceManager.currentSource.id')"
    [ "$text" = '"yz-@[]"' ] || { fail L "typed 'yz-@[]', the dialog shows $text"; return; }
    [ "$layout_after" = "$layout_before" ] \
        || { fail L "the layout is $layout_after after typing, was $layout_before"; return; }
    pass L
}

# tray_needed ITEM STATE: switches the desktop's tray support to STATE for
# an item and remembers what to switch back to in tray_restore.
tray_needed() {
    tray_before="$("$testbed" tray status)" || { fail "$1" "SETUP: tray status failed"; return 1; }
    "$testbed" tray "$2" >/dev/null || { fail "$1" "SETUP: tray $2 failed"; return 1; }
}

tray_restore() {
    [ -n "${tray_before:-}" ] && "$testbed" tray "$tray_before" >/dev/null
    tray_before=""
}

tray_icon_shown() {
    "$testbed" tray-icon >/dev/null 2>&1
}

# Needs tray support on, then checks it off: with the AppIndicator
# extension the app's icon is in the top bar; without it (stock GNOME)
# there is none, and the icon's area looks different.
item_3() {
    local icon area with_icon without_icon
    tray_needed 3 on || return
    app_up 3 || { tray_restore; return; }
    wait_until 15 tray_icon_shown || { tray_restore; fail 3 "no tray icon with the AppIndicator extension on"; return; }
    icon="$("$testbed" tray-icon)"
    area="$(python3 -c 'import json, sys; i = json.loads(sys.argv[1]); print("%d,%d,%d,%d" % (i["x"], i["y"], i["width"], i["height"]))' "$icon")"
    shot item3-topbar --area "0,0,$("$testbed" eval 'Main.layoutManager.primaryMonitor.width'),$("$testbed" eval 'Main.panel.height')" >/dev/null
    with_icon="$(shot item3-icon --area "$area")"
    "$testbed" tray off >/dev/null || { tray_restore; fail 3 "tray off failed"; return; }
    without_icon="$(shot item3-no-icon --area "$area")"
    tray_shown_after_off=0
    tray_icon_shown && tray_shown_after_off=1
    tray_restore
    [ "$tray_shown_after_off" -eq 0 ] || { fail 3 "a tray icon is reported with the extension off"; return; }
    differ "$with_icon" "$without_icon" || { fail 3 "the icon's area looks the same with and without the extension"; return; }
    pass 3
}

# Needs tray support on: a click on the app's tray icon opens its menu,
# Escape closes it.
item_5() {
    local before after
    tray_needed 5 on || return
    app_up 5 || { tray_restore; return; }
    wait_until 15 tray_icon_shown || { tray_restore; fail 5 "SETUP: no tray icon"; return; }
    menu_open() { "$testbed" tray-icon | python3 -c 'import json, sys; sys.exit(0 if json.load(sys.stdin)["menuOpen"] else 1)'; }
    menu_closed() { ! menu_open; }
    before="$(shot item5-before)"
    "$testbed" tray-click >/dev/null || { tray_restore; fail 5 "tray-click failed"; return; }
    if ! wait_until 10 menu_open; then
        tray_restore
        fail 5 "the tray menu did not open"
        return
    fi
    after="$(shot item5-menu)"
    "$testbed" key --shell-modal Escape >/dev/null
    wait_until 10 menu_closed
    local closed=$?
    tray_restore
    differ "$before" "$after" || { fail 5 "the screen looks the same with the menu open"; return; }
    [ "$closed" -eq 0 ] || { fail 5 "Escape did not close the tray menu"; return; }
    pass 5
}

# A recording of the launcher opening and closing is a video of at least
# a second whose first and last frames differ from a frame in between.
# The frames are compared on the machine, which has ffmpeg and
# ImageMagick from provisioning.
item_9() {
    local local_file remote_file check crop
    app_up 9 || return
    # The launcher's area in the video's pixels: its logical rectangle
    # times the monitor's scale. Only that area is compared, since other
    # windows (a terminal on the screen) may change as well.
    "$testbed" control show >/dev/null
    wait_until 10 launcher_is shown || { fail 9 "SETUP: the launcher did not show"; return; }
    crop="$(python3 -c '
import json, sys
w = next(w for w in json.loads(sys.argv[1]) if w["title"] == "")
r, s = w["rect"], int(float(sys.argv[2]))
print("%d,%d,%d,%d" % (r["x"] * s, r["y"] * s, r["width"] * s, r["height"] * s))
' "$("$testbed" windows)" "$("$testbed" eval 'Main.layoutManager.primaryMonitor.geometry_scale')")" \
        || { fail 9 "SETUP: no launcher window"; return; }
    "$testbed" control dismiss >/dev/null
    wait_until 10 launcher_is hidden || { fail 9 "SETUP: the launcher did not hide"; return; }
    "$testbed" record-start item9 >/dev/null || { fail 9 "record-start failed"; return; }
    sleep 1 # a still second before the launcher opens, so the video shows the change
    "$testbed" control show >/dev/null
    wait_until 10 launcher_is shown
    sleep 1
    "$testbed" control dismiss >/dev/null
    wait_until 10 launcher_is hidden
    local_file="$("$testbed" record-stop | tail -n 1)" || { fail 9 "record-stop failed"; return; }
    remote_file="\$HOME/.cache/torchsnap-testbed/recordings/$(basename "$local_file")"
    check="$(on_machine "\"\$HOME/torchsnap/tools/linux-testbed/pi/video-check\" \"$remote_file\" $crop" | tail -n 1)" \
        || { fail 9 "could not read the recording"; return; }
    local problem
    problem="$(python3 -c '
import json, sys
try:
    check = json.loads(sys.argv[1])
except ValueError:
    print("video-check answered: " + sys.argv[1])
    sys.exit()
if check["duration"] < 1:
    print("recording shorter than a second: %s s" % check["duration"])
elif check["white_middle"] - check["white_first"] < 0.03:
    print("the launcher does not show in the recording (light share %.3f at the start, %.3f in the middle)"
          % (check["white_first"], check["white_middle"]))
' "$check")"
    [ -z "$problem" ] || { fail 9 "$problem"; return; }
    pass 9
}

# Text set on the machine's clipboard through the recipe comes back
# unchanged, including characters a shell on either side would expand.
item_6() {
    local token got
    token="testbed \$HOME \`id\` $RANDOM"
    just --justfile "$repo_root/Justfile" testbed-clipboard-set "$token" >/dev/null 2>&1 \
        || { fail 6 "testbed-clipboard-set failed"; return; }
    got="$("$testbed" clipboard-get)" || { fail 6 "clipboard-get failed"; return; }
    [ "$got" = "$token" ] || { fail 6 "set '$token', got '$got'"; return; }
    pass 6
}

# The machine-side commands see the desktop session through the runner
# and without it alike: a runner that clears the whole environment gets
# the same answers.
item_E() {
    local home with without
    app_up E || return
    # Setting the clipboard can close the launcher (it did in 4 of 8 tries
    # on GNOME 48), so it comes before the launcher opens.
    "$testbed" clipboard-set "item E $RANDOM" || { fail E "SETUP: clipboard-set failed"; return; }
    "$testbed" control show >/dev/null || { fail E "SETUP: control show failed"; return; }
    wait_until 10 launcher_is shown || { fail E "SETUP: the launcher is not shown with focus"; return; }
    home="$(on_machine 'echo $HOME')"
    local cleared="env -i HOME=$home PATH=/usr/bin:/bin bash -c"
    with="$(TORCHSNAP_LINUX_RUNNER='' "$testbed" launcher-state; TORCHSNAP_LINUX_RUNNER='' "$testbed" windows)"
    without="$(TORCHSNAP_LINUX_RUNNER="$cleared" "$testbed" launcher-state; TORCHSNAP_LINUX_RUNNER="$cleared" "$testbed" windows)"
    with="$with $(TORCHSNAP_LINUX_RUNNER='' "$testbed" clipboard-get)"
    without="$without $(TORCHSNAP_LINUX_RUNNER="$cleared" "$testbed" clipboard-get)"
    "$testbed" control dismiss >/dev/null
    [ -n "$with" ] && [ "$with" = "$without" ] \
        || { fail E "answers differ: plain ssh: $(tr '\n' ' ' <<<"$with") / cleared environment: $(tr '\n' ' ' <<<"$without")"; return; }
    pass E
}

# A build after a sync has to leave a debug binary written by this build.
item_2() {
    local started built
    if ! started="$(on_machine 'date +%s')"; then
        fail 2 "SETUP: could not read the machine's clock"
        return
    fi
    if ! "$testbed" build; then
        fail 2 "the build failed (see above)"
        return
    fi
    built="$(on_machine 'stat -c %Y "$HOME/torchsnap/src-tauri/target/debug/torchsnap"')" \
        || { fail 2 "no debug binary after the build"; return; }
    [ "$built" -ge "$started" ] \
        || { fail 2 "the debug binary is older than the build ($built < $started)"; return; }
    pass 2
}

# Nobody is at the machine after a reboot, so everything the recipes need
# has to come back on its own.
item_R() {
    local before after env status output
    if ! before="$(on_machine 'cat /proc/sys/kernel/random/boot_id')"; then
        fail R "SETUP: could not read the boot id"
        return
    fi
    if ! "$testbed" reboot; then
        fail R "the reboot did not finish (see above)"
        return
    fi
    after="$(on_machine 'cat /proc/sys/kernel/random/boot_id')"
    [ "$after" != "$before" ] || { fail R "boot id unchanged: $after"; return; }

    env="$(on_machine '"$HOME"/torchsnap/tools/linux-testbed/pi/testbed-pi env')"
    grep -qx 'XDG_CURRENT_DESKTOP=GNOME' <<<"$env" \
        || { fail R "session is not GNOME: $(grep XDG_CURRENT_DESKTOP <<<"$env")"; return; }
    on_machine 'systemctl --user is-active --quiet ydotool.service' \
        || { fail R "ydotool.service is not active"; return; }
    on_machine 'test "$(stat -c %G:%a /dev/uinput)" = input:660' \
        || { fail R "/dev/uinput is not group input, mode 660"; return; }
    on_machine 'systemctl --user is-active --quiet gnome-remote-desktop.service && ss -ltn | grep -q ":3389 "' \
        || { fail R "gnome-remote-desktop is not listening on 3389"; return; }
    [ "$(on_machine "$keyring_unlock")" = "$keyring_unlocked" ] \
        || { fail R "the testbed keyring does not unlock without a prompt"; return; }
    # GNOME Shell announces unsafe mode with a banner over the top of the
    # screen, which would show in screenshots; the extension removes it.
    [ "$(on_machine "$unsafe_mode_notification")" = "(true, 'false')" ] \
        || { fail R "GNOME Shell shows the unsafe-mode notification"; return; }

    output="$("$testbed" provision)"
    status=$?
    if [ "$status" -ne 0 ] || ! grep -q '^provision: 0 changed' <<<"$output"; then
        fail R "provision after the reboot: exit $status, $(grep '^provision:' <<<"$output")"
        return
    fi
    pass R
}

# Each entry: a provision step and a command that undoes it. These are the
# steps that can be undone without reinstalling packages or toolchains
# and without taking the desktop away.
undo_steps=(
    'testbed-extension|sudo rm -rf /usr/local/share/gnome-shell/extensions/unsafe-mode@testbed.torchsnap.app'
    'dconf-defaults|sudo rm /etc/dconf/db/local.d/50-torchsnap-testbed && sudo dconf update'
    'gdm|echo /usr/sbin/lightdm | sudo tee /etc/X11/default-display-manager >/dev/null'
    'accountsservice-session|sudo sed -i "s/^Session=gnome$/Session=/" "/var/lib/AccountsService/users/$USER"'
    'uinput|sudo rm /etc/modules-load.d/torchsnap-testbed-uinput.conf && sudo chmod 600 /dev/uinput'
    'ydotool-service|systemctl --user disable --now ydotool.service'
    'sleep-masked|sudo systemctl unmask hybrid-sleep.target'
    'user-settings|gsettings reset org.gnome.desktop.input-sources sources'
    'keyring|busctl --user call org.freedesktop.secrets /org/freedesktop/secrets org.freedesktop.Secret.Service SetAlias so default /org/freedesktop/secrets/collection/login'
    'rdp|grdctl rdp disable'
)

item_U() {
    local entry step undo output status changed
    output="$("$testbed" provision)"
    if ! grep -q '^provision: 0 changed' <<<"$output"; then
        fail U "SETUP: the machine is not fully provisioned: $(grep '^provision:' <<<"$output")"
        return
    fi
    for entry in "${undo_steps[@]}"; do
        step="${entry%%|*}"
        undo="${entry#*|}"
        if ! on_machine "$undo" >/dev/null; then
            fail U "SETUP: could not undo $step"
            return
        fi
        output="$("$testbed" provision)"
        status=$?
        changed="$(grep '^changed ' <<<"$output" | tr '\n' ' ')"
        if [ "$status" -ne 0 ] || [ "$changed" != "changed $step " ]; then
            fail U "after undoing $step: exit $status, ${changed:-nothing changed}"
            return
        fi
        echo "  undone and restored: $step"
    done
    pass U
}

# Install paths: each entry removes or moves aside what one installing
# step checks for, so provisioning runs that step's install again; the
# moved-aside original is deleted afterwards, or put back when the run
# failed. The fields: step, how to remove it, what to do afterwards on
# success, what to do on failure.
install_steps=(
    'base-packages|sudo apt-get remove -y scdoc|true|sudo apt-get install -y scdoc'
    'rustup|mv ~/.cargo/bin/rustup ~/.cargo/bin/rustup.aside|rm -f ~/.cargo/bin/rustup.aside|mv ~/.cargo/bin/rustup.aside ~/.cargo/bin/rustup'
    'bun|mv ~/.bun ~/.bun.aside|rm -rf ~/.bun.aside|rm -rf ~/.bun && mv ~/.bun.aside ~/.bun'
    'just|mv ~/.local/bin/just ~/.local/bin/just.aside|rm -f ~/.local/bin/just.aside|mv ~/.local/bin/just.aside ~/.local/bin/just'
    'wasm-tools|mv ~/.cargo/bin/wasm-tools ~/.cargo/bin/wasm-tools.aside|rm -f ~/.cargo/bin/wasm-tools.aside|mv ~/.cargo/bin/wasm-tools.aside ~/.cargo/bin/wasm-tools'
)

# Removing any of GNOME's packages would take gnome-shell and gdm with
# it, so the GNOME package step's install runs on the installed system
# and must leave the package list and the display manager choice as they
# were.
readonly gnome_packages_state='dpkg-query -W -f="\${Package} \${Version} \${Status}\n" | md5sum; sudo debconf-show gdm3 lightdm | grep default-x-display-manager'
readonly gnome_packages_apply='cd ~/torchsnap/tools/linux-testbed/provision && bash -c "set -euo pipefail; provision_dir=\$PWD; tree_dir=\$(cd ../../.. && pwd); monitor_spec=; source steps.sh; source base.sh; source desktop-gnome.sh; apply_gnome_packages"'

item_P() {
    local entry step undo cleanup restore output status changed before after
    output="$("$testbed" provision)"
    if ! grep -q '^provision: 0 changed' <<<"$output"; then
        fail P "SETUP: the machine is not fully provisioned: $(grep '^provision:' <<<"$output")"
        return
    fi
    for entry in "${install_steps[@]}"; do
        IFS='|' read -r step undo cleanup restore <<<"$entry"
        if ! on_machine "$undo" >/dev/null; then
            fail P "SETUP: could not remove $step"
            return
        fi
        output="$("$testbed" provision)"
        status=$?
        changed="$(grep '^changed ' <<<"$output" | tr '\n' ' ')"
        if [ "$status" -ne 0 ] || [ "$changed" != "changed $step " ]; then
            on_machine "$restore" >/dev/null
            fail P "after removing $step: exit $status, ${changed:-nothing changed}"
            return
        fi
        on_machine "$cleanup" >/dev/null
        echo "  installed again: $step"
    done

    before="$(on_machine "$gnome_packages_state")"
    on_machine "$gnome_packages_apply" >/dev/null || { fail P "the GNOME package install failed"; return; }
    after="$(on_machine "$gnome_packages_state")"
    [ "$before" = "$after" ] || { fail P "the GNOME package install changed packages or the display manager choice"; return; }
    echo "  installed again on the installed system: gnome-packages"
    pass P
}

# =========================================================
# Runner
# =========================================================

items=("$@")
if [ ${#items[@]} -eq 0 ]; then
    items=("${default_items[@]}")
fi

# Every item is checked before the first runs, so a typo does not cost a
# partial run on the machine.
for item in "${items[@]}"; do
    if ! declare -F "item_$item" >/dev/null; then
        echo "selftest: unknown item: $item" >&2
        exit 2
    fi
done

failed=0
for item in "${items[@]}"; do
    "item_$item" || failed=1
done
exit "$failed"
