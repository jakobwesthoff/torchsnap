# The part of the Linux build that runs inside the container that
# `linux-build` starts. The checkout is mounted read-only at
# `LINUX_BUILD_SRC` and synced into the work volume at
# `LINUX_BUILD_WORK`, where every build step writes; a build's result
# goes to `LINUX_BUILD_OUT`, a directory of the Mac's checkout.
#
# Commands:
#   lint                 cargo check and clippy of src-tauri/ (the repo's own recipes)
#   build PROFILE        `just build` without bundling, then assemble into the output
#   assemble PROFILE OUT lay out a built binary and its resources in OUT
#   glibc BINARY         the highest glibc symbol version BINARY needs

set -euo pipefail

src="${LINUX_BUILD_SRC:-/src}"
work="${LINUX_BUILD_WORK:-/work}"
out="${LINUX_BUILD_OUT:-/out}"

# The container must never write into the Mac's checkout: `bun install`
# would put Linux binaries into its `node_modules/`, and the build
# writes generated files into the tree. So the checkout is copied into
# the work volume. rsync protects excluded paths on the receiver from
# `--delete`, so the gitignored target dirs and `node_modules` there
# survive from one run to the next. rsync reads `.gitignore` files only,
# not `.git/info/exclude` or a global excludes file, hence the anchored
# excludes: `.claude/` holds agent worktrees of a whole other set of
# checkouts, `target/` holds the Mac's build output, and the last-use
# file belongs to the volume, not to the checkout.
#
# Every checkout builds in the same volume, and cargo rebuilds a file
# only when it is newer than the last build's output. A file another
# checkout changed before that build carries an older mtime, so the
# copy keeps no mtimes (`-a` without `-t`) and compares content
# (`--checksum`): a file whose content differs is written anew with the
# time of the copy and gets rebuilt, a file whose content is the same
# keeps the volume's mtime and stays built.
sync_tree() {
    rsync -rlpgoD --checksum --delete --filter=':- .gitignore' \
        --exclude=/.git --exclude=/.claude --exclude=/target --exclude=/.linux-build-last-use \
        "$src/" "$work/"
}

# `linux-build` evicts least recently used work volumes when it has to
# free space; this file is how a volume records its last use.
mark_used() {
    touch "$work/.linux-build-last-use"
}

# Runs one step and reports how long it took, so a build's time splits
# into its phases.
phase() {
    local name="$1" start=$SECONDS
    shift
    "$@"
    echo "linux-build: $name $((SECONDS - start)) s" >&2
}

cmd_lint() {
    mark_used
    sync_tree
    cd "$work"
    # tauri-build needs the generated, gitignored resources and icons
    # (`src-tauri/icons/Assets.car` among them), which the sync leaves
    # out, so `just install` regenerates them first.
    just install
    just check-crates
    just lint-crates
}

# The volume is mounted wherever the caller builds (`/work`, or the path
# of a tree on the target machine), and a profile's target dir keeps
# build-script output with the absolute path it was built at: tauri's
# build script reads its plugin permissions back from there, and cargo
# does not run it again when only the path changed. So each profile
# records the path it was last built at, inside the gitignored target
# dir the sync leaves alone, and a build at another path empties the
# profile's target dir first.
forget_other_work_path() {
    local profile="$1" record last
    record="$work/src-tauri/target/.linux-build-workdir-$profile"
    if [ -f "$record" ]; then
        last="$(cat "$record")"
        if [ "$last" != "$work" ]; then
            echo "linux-build: $profile was last built at $last, not $work; building it from scratch" >&2
            rm -rf "$work/src-tauri/target/$profile"
        fi
    fi
    mkdir -p "$(dirname "$record")"
    echo "$work" >"$record"
}

cmd_build() {
    local profile="$1" release=()
    case "$profile" in
        debug) ;;
        release) release=(--release) ;;
        *)
            echo "in-container: profile must be debug or release, not '$profile'" >&2
            exit 2
            ;;
    esac
    mark_used
    phase sync sync_tree
    cd "$work"
    forget_other_work_path "$profile"
    phase install just install
    phase build just build "${release[@]+"${release[@]}"}" --config '{"bundle":{"active":false}}'
    phase assemble cmd_assemble "$profile" "$out"

    # The image takes its packages from the live trixie archive, so each
    # output records the versions it was built against.
    dpkg-query -W -f '${Package} ${Version}\n' > "$out/build-packages.txt"
}

# Lays out the binary and every resource of `bundle.resources` the way
# Tauri's Debian package does, `bin/torchsnap` next to
# `lib/<productName>/`. A Linux binary outside a cargo target dir finds
# its resources at `<exe dir>/../lib/<productName>` (tauri-utils'
# `resource_dir`), so the output runs from wherever it is copied.
cmd_assemble() {
    local profile="$1" dest="$2"
    local conf="$work/src-tauri/tauri.conf.json"
    local binary="$work/src-tauri/target/$profile/torchsnap"
    local name kind source target path lib

    if [ ! -f "$binary" ]; then
        echo "in-container: no binary at $binary" >&2
        exit 1
    fi
    name=$(jq -r .productName "$conf")
    kind=$(jq -r '.bundle.resources | type' "$conf")
    case "$kind" in
        object | null) ;;
        *)
            echo "in-container: unsupported bundle.resources form ($kind); only a map of files and directories" >&2
            exit 1
            ;;
    esac

    # The output dir is a mount point, so its contents go, not the dir.
    find "$dest" -mindepth 1 -delete
    mkdir -p "$dest/bin"
    cp "$binary" "$dest/bin/torchsnap"
    lib="$dest/lib/$name"
    mkdir -p "$lib"

    if [ "$profile" = debug ]; then
        export_dev_gadgets "$dest/dev-gadgets"
    fi

    [ "$kind" = object ] || return 0
    while IFS=$'\t' read -r source target; do
        case "$source" in
            *'*'* | *'?'* | *'['*)
                echo "in-container: unsupported glob in bundle.resources: $source" >&2
                exit 1
                ;;
        esac
        path="$work/src-tauri/$source"
        case "$source" in
            */)
                if [ ! -d "$path" ]; then
                    echo "in-container: resource directory $source is missing" >&2
                    exit 1
                fi
                mkdir -p "$lib/$target"
                cp -R "$path/." "$lib/$target"
                ;;
            *)
                if [ ! -f "$path" ]; then
                    echo "in-container: resource $source is missing" >&2
                    exit 1
                fi
                mkdir -p "$(dirname "$lib/$target")"
                cp "$path" "$lib/$target"
                ;;
        esac
    done < <(jq -r '.bundle.resources | to_entries[] | "\(.key)\t\(.value)"' "$conf")
}

# A debug binary also loads gadgets from `gadgets/` of the tree it was
# built in (`CARGO_MANIFEST_DIR/../gadgets`), as the archives
# `just build` leaves there. A caller that builds at the path of a tree
# on another machine copies `dev-gadgets/` into that tree's `gadgets/`.
# Only the gadgets `gadgets/bundled.toml` does not list go there: the
# listed ones come from `lib/<productName>/gadgets`, which the loader
# reads first. The loop runs over the gadget directories, not over the
# archives, since the work volume keeps the archives of gadgets the
# checkout no longer has.
export_dev_gadgets() {
    local dir="$1" listed manifest id archive
    mkdir -p "$dir"
    listed=$(cd "$work" && tools/list-bundled-gadgets gadgets/bundled.toml)
    for manifest in "$work"/gadgets/*/manifest.toml; do
        [ -f "$manifest" ] || continue
        id=$(basename "$(dirname "$manifest")")
        if grep -qxF "$id" <<<"$listed"; then
            continue
        fi
        archive="$work/gadgets/$id.torchsnap"
        if [ ! -f "$archive" ]; then
            echo "in-container: no archive gadgets/$id.torchsnap for the gadget in gadgets/$id" >&2
            exit 1
        fi
        cp -p "$archive" "$dir/"
    done
}

cmd_glibc() {
    local binary="$1" version
    version=$(objdump -T "$binary" | { grep -o 'GLIBC_[0-9][0-9.]*' || true; } \
        | sed 's/^GLIBC_//' | sort -u -V | tail -n 1)
    if [ -z "$version" ]; then
        echo "in-container: no GLIBC_ symbol versions in $binary" >&2
        exit 1
    fi
    echo "$version"
}

case "${1:-}" in
    lint) cmd_lint ;;
    build) cmd_build "${2:-}" ;;
    assemble) cmd_assemble "${2:-}" "${3:-}" ;;
    glibc) cmd_glibc "${2:-}" ;;
    *)
        echo "usage: in-container lint | build PROFILE | assemble PROFILE OUT | glibc BINARY" >&2
        exit 2
        ;;
esac
