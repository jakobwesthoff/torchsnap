# =========================================================
# memsnap-report — Format memsnap output into ASCII tables
#
# Generates a full report with:
# - Per-process min/max/avg/delta statistics (from continuous
#   samples produced by `memsnap sample`)
# - Phase-by-phase memory breakdown (from labeled snapshots
#   produced by `memsnap snapshot`)
#
# Either input can be omitted for a partial report.
#
# Usage:
#   memsnap-report -d "description" \
#       --samples data.json --snapshots phases.jsonl
#
# Prerequisites:
#   - jq (brew install jq)
# =========================================================

set -euo pipefail

# =========================================================
# Table rendering
# =========================================================

_repeat_char() {
    local width="$1" char="$2"
    printf '%s\n' "$(printf "%${width}s" '' | sed -e "s/ /${char}/g")"
}

_max_line_width() {
    local max=0
    while IFS= read -r line; do
        (( ${#line} > max )) && max=${#line}
    done <<< "$1"
    echo "$max"
}

render_table() {
    local tsv_rows="$1"
    local formatted
    formatted=$(echo "$tsv_rows" | column -t -s$'\t')

    local total_lines
    total_lines=$(echo "$formatted" | wc -l | tr -d ' ')

    local width
    width=$(_max_line_width "$formatted")

    _repeat_char "$width" "═"
    echo "$formatted" | head -1
    _repeat_char "$width" "─"
    echo "$formatted" | tail -n +"2" | head -n "$((total_lines - 2))"
    _repeat_char "$width" "─"
    echo "$formatted" | tail -1
    _repeat_char "$width" "═"
}

# =========================================================
# Format helpers
# =========================================================

fmt_mb() {
    awk "BEGIN { printf \"%.1f MB\", $1 / 1048576 }"
}

fmt_delta() {
    awk "BEGIN { printf \"%+.1f MB\", $1 / 1048576 }"
}

# =========================================================
# CLI
# =========================================================

DESCRIPTION=""
SAMPLES_FILE=""
SNAPSHOTS_FILE=""

usage() {
    cat <<'EOF'
Usage: memsnap-report [OPTIONS]

Generate a memory report from memsnap data.

At least one of --samples or --snapshots must be provided.

Options:
  -d, --description <TEXT>      Description of what was tested
  -s, --samples <FILE>          Continuous samples JSON (from `memsnap sample`)
  -n, --snapshots <FILE>        Phase snapshots JSONL (from `memsnap snapshot`)
  -h, --help                    Show this help
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--description) DESCRIPTION="$2"; shift 2 ;;
        -s|--samples)     SAMPLES_FILE="$2"; shift 2 ;;
        -n|--snapshots)   SNAPSHOTS_FILE="$2"; shift 2 ;;
        -h|--help)        usage; exit 0 ;;
        -*)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
        *)
            echo "Unexpected argument: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

if [[ -z "$SAMPLES_FILE" ]] && [[ -z "$SNAPSHOTS_FILE" ]]; then
    echo "Error: At least one of --samples or --snapshots is required." >&2
    usage >&2
    exit 1
fi

if [[ -n "$SAMPLES_FILE" ]] && [[ ! -f "$SAMPLES_FILE" ]]; then
    echo "Error: Samples file not found: $SAMPLES_FILE" >&2
    exit 1
fi

if [[ -n "$SNAPSHOTS_FILE" ]] && [[ ! -f "$SNAPSHOTS_FILE" ]]; then
    echo "Error: Snapshots file not found: $SNAPSHOTS_FILE" >&2
    exit 1
fi

if ! command -v jq &>/dev/null; then
    echo "Error: jq is not installed. Install it with: brew install jq" >&2
    exit 1
fi

# =========================================================
# Report header
# =========================================================

if [[ -n "$DESCRIPTION" ]]; then
    echo "  $DESCRIPTION"
fi
echo "  $(date +%Y-%m-%dT%H:%M:%S)"
echo

# =========================================================
# Section 1: Per-process statistics (continuous samples)
# =========================================================

if [[ -n "$SAMPLES_FILE" ]]; then
    REPORT_DATA=$(jq -r '
        (.samples | length) as $num_samples |

        [
            .samples[].processes[] | {
                name: .name,
                pid: .pid,
                footprint: .auxiliary.phys_footprint
            }
        ] |
        group_by(.pid) |
        . as $groups |
        {
            meta: { num_samples: $num_samples },
            processes: [
                $groups[] | {
                    name: .[0].name,
                    pid: .[0].pid,
                    min: ([.[].footprint] | min),
                    max: ([.[].footprint] | max),
                    avg: (([.[].footprint] | add) / length | round),
                    first: (.[0].footprint),
                    last: (.[-1].footprint)
                }
            ] | sort_by(-.avg),
            totals: {
                min: [$groups[] | [.[].footprint] | min] | add,
                max: [$groups[] | [.[].footprint] | max] | add,
                avg: [$groups[] | (([.[].footprint] | add) / length | round)] | add,
                first: [$groups[] | .[0].footprint] | add,
                last: [$groups[] | .[-1].footprint] | add
            }
        } |

        "META\t\(.meta.num_samples)",
        (.processes[] |
            "PROC\t\(.name)\t\(.pid)\t\(.min)\t\(.max)\t\(.avg)\t\(.first)\t\(.last)"
        ),
        "TOTAL\t\(.totals.min)\t\(.totals.max)\t\(.totals.avg)\t\(.totals.first)\t\(.totals.last)"
    ' "$SAMPLES_FILE")

    NUM_SAMPLES=""
    ROWS="Process	PID	Min	Max	Avg	Delta"

    while IFS=$'\t' read -r tag rest; do
        case "$tag" in
            META)
                NUM_SAMPLES="$rest"
                ;;
            PROC)
                IFS=$'\t' read -r name pid min max avg first last <<< "$rest"
                ROWS+=$'\n'"${name}	${pid}	$(fmt_mb "$min")	$(fmt_mb "$max")	$(fmt_mb "$avg")	$(fmt_delta "$((last - first))")"
                ;;
            TOTAL)
                IFS=$'\t' read -r t_min t_max t_avg t_first t_last <<< "$rest"
                ROWS+=$'\n'"TOTAL	 	$(fmt_mb "$t_min")	$(fmt_mb "$t_max")	$(fmt_mb "$t_avg")	$(fmt_delta "$((t_last - t_first))")"
                ;;
        esac
    done <<< "$REPORT_DATA"

    echo "  Continuous samples: ${NUM_SAMPLES}"
    echo
    render_table "$ROWS"
fi

# =========================================================
# Section 2: Phase-by-phase breakdown (snapshots)
# =========================================================

if [[ -n "$SNAPSHOTS_FILE" ]]; then
    NUM_SNAPSHOTS=$(wc -l < "$SNAPSHOTS_FILE" | tr -d ' ')

    PHASE_TABLE=$(jq -s -r '
        . as $snaps |
        [.[] | .processes[]] | group_by(.name) |
        sort_by(-([.[].auxiliary.phys_footprint] | add)) |
        map(.[0].name) as $names |

        # Shorten: "com.apple.WebKit.WebContent" → "WebContent"
        ($names | map(split(".") | last)) as $short |

        # Header
        (["Phase"] + $short + ["TOTAL"] | join("\t")),

        # Data rows
        ($snaps | to_entries[] |
            .value as $snap |
            [$names[] as $n |
                ($snap.processes | map(select(.name == $n)) | .[0].auxiliary.phys_footprint // 0)
            ] as $vals |
            ([$vals[] | . / 1048576 | . * 10 | round / 10 | tostring + " MB"]) as $fmt |
            ($vals | add | . / 1048576 | . * 10 | round / 10 | tostring + " MB") as $t |
            ([$snap.phase] + $fmt + [$t] | join("\t"))
        ),

        # Delta row
        ($snaps[0] as $first | $snaps[-1] as $last |
            [$names[] as $n |
                (($last.processes | map(select(.name == $n)) | .[0].auxiliary.phys_footprint // 0) -
                 ($first.processes | map(select(.name == $n)) | .[0].auxiliary.phys_footprint // 0))
            ] as $d |
            ([$d[] | . / 1048576 | if . >= 0 then "+" else "" end + (. * 10 | round / 10 | tostring) + " MB"]) as $fmt |
            ($d | add | . / 1048576 | if . >= 0 then "+" else "" end + (. * 10 | round / 10 | tostring) + " MB") as $t |
            (["Δ first → last"] + $fmt + [$t] | join("\t"))
        )
    ' "$SNAPSHOTS_FILE")

    # Add spacing between sections if we already printed samples
    if [[ -n "$SAMPLES_FILE" ]]; then
        echo
    fi

    echo "  Phase snapshots: ${NUM_SNAPSHOTS}"
    echo
    render_table "$PHASE_TABLE"
fi
