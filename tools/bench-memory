# =========================================================
# bench-memory — End-to-end memory benchmark for Torchsnap
#
# Performs a full benchmark cycle:
# 1. Builds the release app (app bundle only, no DMG)
# 2. Ensures the Control API is enabled in settings
# 3. Launches the app
# 4. Waits for the control socket to become available
# 5. Starts continuous memory sampling in the background
# 6. Runs a realistic usage scenario via the Control API,
#    taking a discrete memory snapshot after each phase
# 7. Stops sampling and kills the app
# 8. Appends a combined report (overall stats + phase
#    breakdown) to the benchmark log
#
# Usage:
#   tools/bench-memory -d "baseline, no optimizations"
#
# Prerequisites:
#   - socat (brew install socat)
#   - jq (brew install jq)
# =========================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
APP_BUNDLE="$PROJECT_DIR/src-tauri/target/release/bundle/macos/torchsnap.app"
SETTINGS_DIR="$HOME/Library/Application Support/app.torchsnap"
SETTINGS_FILE="$SETTINGS_DIR/settings.json"
SOCK="$SETTINGS_DIR/control.sock"
LOG_FILE="$PROJECT_DIR/memory-benchmark.log"

# ---------------------------------------------------------
# CLI
# ---------------------------------------------------------

DESCRIPTION=""
SKIP_BUILD=false

usage() {
    cat <<'EOF'
Usage: bench-memory [OPTIONS]

Run a full memory benchmark cycle (build → launch → measure → report).

Options:
  -d, --description <TEXT>   Description for the log entry (required)
  --skip-build               Skip the release build step
  -h, --help                 Show this help
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--description) DESCRIPTION="$2"; shift 2 ;;
        --skip-build)     SKIP_BUILD=true; shift ;;
        -h|--help)        usage; exit 0 ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

if [[ -z "$DESCRIPTION" ]]; then
    echo "Error: -d/--description is required." >&2
    usage >&2
    exit 1
fi

# ---------------------------------------------------------
# Prerequisites
# ---------------------------------------------------------

for cmd in socat jq; do
    if ! command -v "$cmd" &>/dev/null; then
        echo "Error: $cmd is not installed. Install it with: brew install $cmd" >&2
        exit 1
    fi
done

# ---------------------------------------------------------
# Control API helper
# ---------------------------------------------------------

LAST_ID=0
send() {
    local method="$1"
    local params="${2:-}"
    local id=$((LAST_ID++))

    local request
    if [[ -n "$params" ]]; then
        request="{\"jsonrpc\":\"2.0\",\"id\":$id,\"method\":\"$method\",\"params\":$params}"
    else
        request="{\"jsonrpc\":\"2.0\",\"id\":$id,\"method\":\"$method\"}"
    fi

    local response
    response=$(echo "$request" | socat - UNIX-CONNECT:"$SOCK")

    local error
    error=$(echo "$response" | jq -r '.error.message // empty' 2>/dev/null)
    if [[ -n "$error" ]]; then
        echo "  Warning: $method returned error: $error" >&2
    fi
}

# ---------------------------------------------------------
# Cleanup — kill the app and sampler on exit
# ---------------------------------------------------------

APP_PID=""
MEMSNAP_PID=""

cleanup() {
    if [[ -n "$MEMSNAP_PID" ]] && kill -0 "$MEMSNAP_PID" 2>/dev/null; then
        kill "$MEMSNAP_PID" 2>/dev/null || true
        wait "$MEMSNAP_PID" 2>/dev/null || true
    fi
    if [[ -n "$APP_PID" ]] && kill -0 "$APP_PID" 2>/dev/null; then
        echo "Stopping Torchsnap (PID $APP_PID)..."
        kill "$APP_PID" 2>/dev/null || true
        wait "$APP_PID" 2>/dev/null || true
    fi
}
trap cleanup EXIT

# ---------------------------------------------------------
# Snapshot helper — delegates to `memsnap snapshot`
# ---------------------------------------------------------

SAMPLES_FILE="bench-memory-$(date +%Y%m%d-%H%M%S).json"
SNAPSHOTS_FILE="bench-memory-$(date +%Y%m%d-%H%M%S).snapshots.jsonl"

snap() {
    "$SCRIPT_DIR/memsnap" snapshot -l "$1" -o "$SNAPSHOTS_FILE"
}

# =========================================================
# Step 1: Build release app
# =========================================================

if [[ "$SKIP_BUILD" == true ]]; then
    echo "Skipping build (--skip-build)."
    if [[ ! -d "$APP_BUNDLE" ]]; then
        echo "Error: App bundle not found at $APP_BUNDLE" >&2
        echo "Run without --skip-build first." >&2
        exit 1
    fi
else
    echo "Building release app..."
    (cd "$PROJECT_DIR" && bun run tauri build -b app)
    echo
fi

# =========================================================
# Step 2: Ensure Control API is enabled
# =========================================================

mkdir -p "$SETTINGS_DIR"

if [[ -f "$SETTINGS_FILE" ]]; then
    CURRENT=$(jq -r '.["controlChannel.enabled"] // false' "$SETTINGS_FILE")
    if [[ "$CURRENT" != "true" ]]; then
        echo "Enabling Control API in settings..."
        jq '.["controlChannel.enabled"] = true' "$SETTINGS_FILE" > "${SETTINGS_FILE}.tmp"
        mv "${SETTINGS_FILE}.tmp" "$SETTINGS_FILE"
    fi
else
    echo "Creating settings with Control API enabled..."
    echo '{"controlChannel.enabled": true}' > "$SETTINGS_FILE"
fi

# =========================================================
# Step 3: Kill any existing Torchsnap instance
# =========================================================

if pgrep -x torchsnap &>/dev/null; then
    echo "Stopping existing Torchsnap instance..."
    pkill -x torchsnap
    sleep 1
fi

# =========================================================
# Step 4: Launch the app
# =========================================================

echo "Launching Torchsnap..."
open "$APP_BUNDLE"

for _ in $(seq 1 30); do
    APP_PID=$(pgrep -x torchsnap 2>/dev/null || true)
    if [[ -n "$APP_PID" ]]; then break; fi
    sleep 0.2
done

if [[ -z "$APP_PID" ]]; then
    echo "Error: Torchsnap did not start within 6 seconds." >&2
    exit 1
fi

echo "Torchsnap PID: $APP_PID"

# =========================================================
# Step 5: Wait for the control socket
# =========================================================

echo "Waiting for control socket..."
CONTROL_READY=false
for _ in $(seq 1 50); do
    if [[ -S "$SOCK" ]]; then
        if echo '{"jsonrpc":"2.0","id":0,"method":"status"}' \
            | socat -T1 - UNIX-CONNECT:"$SOCK" &>/dev/null; then
            CONTROL_READY=true
            break
        fi
    fi
    sleep 0.2
done

if [[ "$CONTROL_READY" != true ]]; then
    echo "Error: Control API did not become ready within 10 seconds." >&2
    exit 1
fi

echo "Control API ready."

# =========================================================
# Step 6: Start continuous sampler (background)
# =========================================================

echo
echo "=== Torchsnap Memory Benchmark ==="
echo "  $DESCRIPTION"
echo

# Ensure the launcher starts hidden
send "dismiss"
sleep 0.5

SCENARIO_DURATION=55

echo "Starting background sampler (${SCENARIO_DURATION}s, 200ms interval)..."
"$SCRIPT_DIR/memsnap" sample \
    -i 0.2 \
    -d "$SCENARIO_DURATION" \
    -o "$SAMPLES_FILE" &
MEMSNAP_PID=$!
sleep 1

# =========================================================
# Step 7: Run the test scenario
#
# Each phase ends with a discrete memory snapshot via
# `memsnap snapshot`. The phase labels become rows in the
# final report.
# =========================================================

echo "Running scenario..."
echo

# --- Baseline: app just started, launcher hidden ---
snap "app started (idle)"

# --- First show/dismiss cycle ---
send "show"
sleep 2
snap "launcher visible (empty)"
send "dismiss"
sleep 2
snap "after first dismiss"

# --- App search ---
send "show"
sleep 1
send "query" '{"text":"Safari"}'
sleep 2
snap "query: Safari"
send "query" '{"text":"Terminal"}'
sleep 2
snap "query: Terminal"
send "dismiss"
sleep 2
snap "after app search dismiss"

# --- Emoji picker ---
send "show"
sleep 1
send "query" '{"text":":rocket"}'
sleep 2
snap "query: :rocket (emoji)"
send "query" '{"text":":fire"}'
sleep 2
snap "query: :fire (emoji)"
send "dismiss"
sleep 2
snap "after emoji dismiss"

# --- Rapid show/dismiss cycles ---
for _ in 1 2 3 4 5; do
    send "show"
    sleep 0.3
    send "dismiss"
    sleep 0.3
done
sleep 2
snap "after 5 rapid cycles"

# --- Final query + long idle ---
send "show"
send "query" '{"text":"settings"}'
sleep 3
snap "query: settings"
send "dismiss"
sleep 5
snap "final idle"

echo
echo "Scenario complete. Waiting for sampler..."

# =========================================================
# Step 8: Collect results
# =========================================================

wait "$MEMSNAP_PID" 2>/dev/null || true
MEMSNAP_PID=""

# =========================================================
# Step 9: Stop the app
# =========================================================

echo "Stopping Torchsnap..."
kill "$APP_PID" 2>/dev/null || true
wait "$APP_PID" 2>/dev/null || true
APP_PID=""

# =========================================================
# Step 10: Generate and append report
# =========================================================

echo

REPORT_ARGS=(-d "$DESCRIPTION")
if [[ -f "$SAMPLES_FILE" ]]; then
    REPORT_ARGS+=(-s "$SAMPLES_FILE")
fi
if [[ -f "$SNAPSHOTS_FILE" ]]; then
    REPORT_ARGS+=(-n "$SNAPSHOTS_FILE")
fi

REPORT=$("$SCRIPT_DIR/memsnap-report" "${REPORT_ARGS[@]}")
echo "$REPORT"
echo "$REPORT" >> "$LOG_FILE"

echo
echo "Report appended to: $LOG_FILE"
echo "Continuous data: $SAMPLES_FILE"
echo "Snapshot data: $SNAPSHOTS_FILE"
